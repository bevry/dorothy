#!/usr/bin/env bash

# https://github.com/mikefarah/yq
# https://mikefarah.gitbook.io/yq

# https://repology.org/project/yq-mikefarah/versions

function setup_util_yq() (
	source "$DOROTHY/sources/bash.bash"

	# improve performance for detectable utilities with conditional assets
	if setup-util --check --cli=yq "$@"; then
		return 0
	fi

	# despite docs, no apk
	local options=(
		--cli='yq'
		"$@"
		APK='yq'
		BREW='yq'
		GENTOO='app-misc/yq-go'
		GO='github.com/mikefarah/yq/v4@latest'
		NIX='yq-go'
		RPM='yq'
		SCOOP='yq'
		SNAP='yq'
		VOID='yq-go'
		ZYPPER='yq'
	)
	setup-util "${options[@]}"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_util_yq "$@"
fi
