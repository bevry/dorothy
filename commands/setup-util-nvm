function setup_util_nvm() (
	source "$DOROTHY/sources/util.bash"
	util_options=(
		--name='Node.js Version Manager (NVM)'
		--checker='node-env -- nvm --version'
		--configure-eval='nvm_configure'
		CUSTOM_UPSTALL_EVAL='__nvm_upstall'
		CUSTOM_UNINSTALL_EVAL='__nvm_uninstall'
	)
	function nvm_configure {
		if [[ $SETUP_UTIL__INSTALLED == 'yes' && $SETUP_UTIL__EXTRA == 'yes' ]]; then
			source "$DOROTHY/sources/config.sh"

			# setup.bash provides:
			local NVM_NODE_VERSIONS=()
			load_dorothy_config 'setup.bash'

			# Additional Node.js versions
			if [[ ${#NVM_NODE_VERSIONS[@]} -ne 0 ]]; then
				setup-util --transpose=NVM -- "${NVM_NODE_VERSIONS[@]}" || return $?
			fi
		fi
	}
	function __nvm_upstall() (
		# ensure
		if [[ -z ${NVM_DIR-} ]]; then
			export NVM_DIR="$HOME/.nvm"
		fi
		# create/init/configure the repo for this remote
		git-helper sync --path="$NVM_DIR" --remote='origin' --protocol='https' --url='https://github.com/nvm-sh/nvm.git' --no-update || return $?
		# update tags and checkout the latest stable tag
		cd "$NVM_DIR" || return $?
		git fetch --tags origin || return $?
		local hash tag
		hash="$(git rev-list --tags --max-count=1)" || return $?
		tag="$(git describe --abbrev=0 --tags --match "v[0-9]*" "$hash")" || return $?
		git checkout "$tag" || return $?
	)
	function __nvm_uninstall {
		fs-remove --quiet --no-confirm -- "$NVM_DIR" || return $?
	}
	setup_util "${util_options[@]}" "${setup_options[@]}"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_util_nvm "$@"
fi
