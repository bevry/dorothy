			*) __unrecognised_argument "$item" || return $? ;;
			esac
		done
		# inherits {SETUP_UTIL__SOURCE} {packages} {search}
		case "$option_action" in
		'setup-upgrade-all') : ;;
		'is-'* | 'setup-*')
			if [[ ${#packages[@]} -eq 0 ]]; then
				return "$STATUS__PACKAGE_NA"
			fi
			;;
		'search-'*)
			if [[ ${#packages[@]} -eq 0 && ${#option_search[@]} -eq 0 ]]; then
				return "$STATUS__PACKAGE_NA"
			fi
			;;
		esac
		if __command_missing -- "$command"; then
			if [[ "$fallback" == 'yes' ]]; then
				return "$STATUS__SYSTEM_FALLBACK"
			else
				return "$STATUS__SYSTEM_MISSING"
			fi
		fi
	}


