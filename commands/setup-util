	}
	function __setup__mas {
		local args=() packages=("${MAS[@]}") package

		# applicability
		if ! __is_macos; then
			return "$STATUS__SOURCE_NOT_FOR_SYSTEM"
		fi
		case "$option_action" in
		'invoke' | 'system-clean' | 'system-upgrade') return "$STATUS__ACTION_NOT_FOR_SOURCE" ;;
		esac
		__applicable --fallback || return $?

		# action
		case "$option_action" in
		# is-*  ...<package
		# `mas list ...<package>` will STDOUT for all found, STDERR for the missing, and if any missing [1] exit status>
		'is-installed-all')
			__mas list "${packages[@]}" &>/dev/null || return $?
			;;
		'is-installed-any')
			__mas list "${packages[@]}" 2>/dev/null | __expect_from_stdin 'any' || return $?
			;;
		'is-installed-none')
			__mas list "${packages[@]}" 2>/dev/null | __expect_from_stdin 'none'  || return $?
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		'list-installed')
			setup-util-jq --dependency || return $?
			if [[ ${#option_search[@]} -eq 0 ]]; then
				__mas list --json "${packages[@]}" | __parse_mas_list_lookup_outdated_search_to_id_version || return $?
			else
				__mas list --json 2>/dev/null | __parse_mas_list_lookup_outdated_search_to_id_version | __filter_for_packages_and_search || return $?
			fi
			;;
		'list-outdated')
			setup-util-jq --dependency || return $?
			if [[ ${#option_search[@]} -eq 0 ]]; then
				__mas outdated --json "${packages[@]}" | __parse_mas_outdated_to_id_versions || return $?
			else
				__mas outdated --json | __parse_mas_outdated_to_id_versions | __filter_for_packages_and_search || return $?
			fi
			;;
		'list-updated')
			__list_updated_by_evicting_outdated_from_installed || return $?
			;;
		'list-available')
			if [[ ${#packages[@]} -eq 0 && ${#option_search[@]} -eq 0 ]]; then
				# this would be millions of apps...
				return "$STATUS__NOT_IMPLEMENTED"
			else
				{
					if [[ ${#packages[@]} -ne 0 ]]; then
						__mas lookup --json "${packages[@]}" 2>/dev/null || :
					fi
					if [[ ${#option_search[@]} -ne 0 ]]; then
						__mas search --json "${option_search[@]}" || return $?
					fi
				} | __parse_mas_list_lookup_outdated_search_to_id_version | echo-unique --stdin || return $?
			fi
			;;
		# setup-* ...<package>
		'setup-uninstall')
			__mas uninstall "${packages[@]}" || return $?
			;;
		'setup-install')
			__mas install "${packages[@]}" || return $?
			;;
		'setup-upstall')
			setup-util-jq --dependency || return $?
			local package
			while read package; do
				__elevate -- __mas update "$package" || return $?
			done < <(__mas outdated --json "${packages[@]}" | __parse_mas_list_lookup_outdated_search_to_id)
			while read package; do
				__elevate -- __mas install "$package" || return $?
			done < <(__mas list --json "${packages[@]}" | __parse_mas_list_lookup_outdated_search_to_id)
			
			local package
			for package in "${packages[@]}"; do
				if __mas outdated "$package" 2>/dev/mull; then
					__elevate -- __mas update "$package" || return $?
				elif ! __mas list "$package"; then
					__elevate -- __mas install "$package" || return $?
				fi
				# else installed and up to date
			done
			;;
		'setup-update')
			__mas update "${packages[@]}" || return $?
			;;
		# system-*
		'system-update')
			__mas update || return $?
			;;
		# unhandled
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}
