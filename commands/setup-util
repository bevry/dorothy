		# 		--newline \
		# 		--red='Once the command is created, re-run your prior command.'
		# 	return 1
		# fi
	fi

	# move this is to the end, as if it is a valid action, then it gets handled, only if it is invalid, it would have reached the end without handling
	if ! [[ $option_action =~ ^(setup|check|is|want|get|invoke)$ ]]; then
		__help --help='Invalid <action>.' || return $?
	fi

	# ensure name fallback
	if [[ -z $option_name ]]; then
		if [[ ${#option_apps[*]} -ne 0 ]]; then
			option_name="${option_apps[0]}"
		elif [[ ${#option_clis[@]} -ne 0 ]]; then
			__join --source={option_clis} --between='|' --target={option_name} || return $?
		elif [[ ${#option_fonts[*]} -ne 0 ]]; then
			option_name="${option_fonts[0]}"
		elif [[ -n $option_source ]]; then
			option_name="$option_source"
		elif [[ -n $option_checker ]]; then
			option_name="$option_checker"
		fi
	fi
	if [[ -z $option_name ]]; then
		__help --help='Either <name>, <cli>, <app>, <font>, <source>, <checker> must be provided.' || return $?
	fi

	# prep terminal vars
	local use_alt_screen_buffer
	if [[ $option_quiet != 'no' && $ALTERNATIVE_SCREEN_BUFFER_SUPPORTED == 'yes' ]]; then
		use_alt_screen_buffer='yes'
		__load_styles --save -- alternative_screen_buffer default_screen_buffer || return $?
