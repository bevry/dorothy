				__print_error 'No files matched the ' --variable={name} ' ' --variable={glob} ' within ' --path="$download_directory" --newline --bold='Expected:' --newline --variable={target_paths} --newline --bold='Actual:' || return $?
				fs-structure -- "$download_directory" >&2 || return $?
				return 1
			elif [[ ${#filtered_paths[@]} -eq ${#target_paths[@]} || ${#target_paths[@]} -eq 0 ]]; then
				# move the files
				if [[ ${#filtered_paths[@]} -gt 1 ]]; then
					__sort --source+target={filtered_paths} || return $?
				fi
				for i in "${!target_paths[@]}"; do
					filtered_path="${filtered_paths[i]}"
					target_path="${target_paths[i]}"
					fs-move --verbose --overwrite -- "$filtered_path" "$target_path" || return $?
				done
			else
				__print_error 'Too many files matched the ' --variable={name} ' ' --variable={glob} ' within ' --path="$download_directory" --newline --bold='Expected:' --newline --variable={target_paths} --newline --bold='Actual:' --newline --variable={filtered_paths} || return $?
				fs-structure -- "$download_directory" >&2 || return $?
				return 1
			fi
		}
		if [[ -n $build_install ]]; then
			# build install
			local -i build_status
			__print_style --info1='Building ' --variable-value={option_name} --info1=' in ' --variable-value={download_directory} --info1=' ...' || return $?
			# can't do cd in a subshell as we want to capture the status
			pushd "$download_directory" &>/dev/null
			__try {build_status} -- "$build_install" # unsafe eval
			popd &>/dev/null
			if [[ $build_status -eq 0 ]]; then
				__print_style --good1='Built ' --variable-value={option_name} --good1=' in ' --variable-value={download_directory} || return $?
			else
				__print_style --stderr --error1='Failed to build ' --variable-value={option_name} --error1=' in ' --variable-value={download_directory} || return $?
				return "$build_status"
			fi
			# move to target path if have pattern
			if [[ -n $build_glob ]]; then
				__relocate_glob 'build glob filter' "$build_glob" || return $?
			fi
		elif [[ -n $download_directory ]]; then
			__relocate_glob 'extraction' '*' || return $?
		elif [[ -n $download_filepath && $download_filepath != "${target_paths[0]}" ]]; then
			fs-move --verbose --overwrite -- "$download_filepath" "${target_paths[0]}" || return $?
		fi

		# verify
		if [[ $infer_from_font == 'yes' ]]; then
			if ! get-font --quiet -- "${option_fonts[@]}"; then
				__print_style --stderr --error1='Failed to verify font installation: ' --variable={option_fonts} || return $?
				return 1
			fi
		else
			for target_path in "${target_paths[@]}"; do
				__verify_saved_path "$target_path" || return $?
			done
		fi
	}

	# installer
	function __is_applicable__installer {
		local file_or_url="$INSTALLER"

		# check if applicable
		if [[ -z $file_or_url ]]; then
			return 200 # ECUSTOM 200 Not applicable to this utility
		fi
		if [[ $option_action == 'uninstall' ]]; then
			return 200 # ECUSTOM 200 Not applicable to this utility
		fi
		if [[ $file_or_url == *'/setup-util-'* ]]; then
			__help --help='Using `INSTALLER=setup-util-*` --is deprecated, use an alternative for ' --variable-value={option_name} || return $?
			return 43 # EPROTONOSUPPORT 43 Protocol not supported
		fi
	}
	function __setup__installer {
		local args=() filepath file_or_url="$INSTALLER" filename="$INSTALLER_FILENAME" open="$INSTALLER_OPEN" uninstall_arguments=("${INSTALLER_UNINSTALL_ARGUMENT[@]}")

		# optional filename
		if [[ -z $filename ]]; then
			# include extension
			filename="$(basename -- "$file_or_url")" || return $?
		fi

		# check if it is local, or remote
		if is-present -- "$file_or_url"; then
			filepath="$file_or_url"
		else
			# it is remote
			# download it to a temporary location and use that
			filepath="$(fs-make --cache --directory='dorothy' --directory='setup-util' --directory="$option_name" --file="$filename")" || return $?
			down "$file_or_url" --filepath="$filepath" || return $?
		fi

		# ensure it is executable, then open or run it
		fs-own --permissions='+x' -- "$filepath" || return $?
		if [[ $open == 'yes' ]]; then
			if __is_wsl; then
				setup-util-wslu --dependency --quiet="$option_quiet" || return $?
				wslview "$filepath" || return $?
			else
				open "$filepath" || return $?
			fi
		else
			# external installer script
			local arguments=()
			if [[ $option_action == 'uninstall' ]]; then
				arguments+=("${uninstall_arguments[@]}")
			fi
			"$filepath" "${arguments[@]}"
		fi
	}

	function __is_applicable__generic {
		# check if applicable
		if [[ $option_action != 'uninstall' ]]; then
			return 200
		fi
	}
	function __get__generic {
		local app name app_extensions extension replace_options app_paths app_path success='no' found
		for app in "${option_apps[@]}"; do
			name='' bin_extensions=() app_extensions=() replace_options=() app_paths=() found='no'
			if [[ -z $app ]]; then
				return 22 # EINVAL 22 Invalid argument
			fi
			# remove suffixes from name
			if [[ $system == 'macos' ]]; then
				app_extensions+=('app')
			elif [[ $system == 'windows' ]]; then
				bin_extensions+=('exe')
				app_extensions+=('exe')
			elif [[ $system == 'linux' ]]; then
				app_extensions+=('desktop')
				if [[ $appimage == 'yes' ]]; then
					app_extensions+=('appimage' 'Appimage' 'AppImage' 'appImage') # case-sensitive filesystems
				fi
			fi
			for extension in "${bin_extensions[@]}" "${app_extensions[@]}"; do
				replace_options+=("--suffix=.$extension")
			done
			__replace --source={app} --target={name} --optional "${replace_options[@]}"
			# iterate through PATH
			if [[ $sources == *'[bins]'* ]]; then
				# which doing executable scans, also search just for the name, as apps usually have a corresponding CLI, e.g.
				# /usr/bin/vivaldi
				# /usr/bin/vivaldi
				# /usr/sbin/vivaldi
				# /sbin/vivaldi
				# /bin/vivaldi
				__split --target={app_paths} --append --no-zero-length --invoke=try -- \
					__get_bin_paths "$name"
			fi
			# iterate through apps
			# only fetch if necessary as is slow
			if [[ ! ($option_which == 'first' && ${#app_paths[@]} -ne 0) && $sources == *'[apps]'* ]]; then
				__split --target={app_paths} --append --no-zero-length --invoke=try -- \
					__get_app_paths "$name"
			fi
			# cycle through app paths
			for app_path in "${app_paths[@]}"; do
				# app was found
				found='yes'
				if [[ -n $option_output ]]; then
					local app_name app_id
					if [[ $app_path == *.app ]]; then
						# @todo add version
						app_name="$(defaults read "$app_path/Contents/Info.plist" CFBundleName || :)"
						app_id="$(defaults read "$app_path/Contents/Info.plist" CFBundleIdentifier || :)"
					elif [[ $app_path == *.desktop ]]; then
						# @todo add version
						app_name="$(config-helper --path="$app_path" -- --field='Name' || :)"
						app_id="$(fs-path --no-parents --no-extensions -- "$app_path")"
					else
						app_name="$(fs-path --no-parents -- "$app_path")"
					fi
					case "$option_output" in
					'details') __dump {name} {app_name} {app_id} {app_path} ;;
					'input') __print_lines "$app" ;;
					'name') __print_lines "$app_name" ;;
					'id') __print_lines "${app_id:-"$app_name"}" ;;
					'path') __print_lines "$app_path" ;;
					esac
				fi
				if [[ $option_invoke == 'yes' ]]; then
					open -a "$app_path" "${option_args[@]}" # eval
				fi
				case "$option_which" in
				'first') return 0 ;;
				'each') break 2 ;;
				esac
			done
			# handle found or not found
			if [[ $found == 'yes' ]]; then
				success='yes'
			elif [[ $option_need == 'all' ]]; then
				return 3 # ESRCH 3 No such process
			fi
		done
		# did we find anything?
		if [[ $success == 'no' && $option_need != 'optional' ]]; then
			return 3 # ESRCH 3 No such process
		fi
	}
	function __setup__generic {
		local paths=() item path
		if [[ $option_action == 'uninstall' ]]; then
			# clis and apps have same paths
			for item in "${option_clis[@]}" "${option_apps[@]}"; do
				path="$(__get_path_from_filename "$item")" || return $?
				paths+=("$path" "$XDG_BIN_HOME/$item" "/usr/local/bin/$item")
			done
			# however apps also have additional paths
			# @todo add .appimage and .desktop and whatnot files
			# now de-dupe
			__unique --source+target={paths} || return $?
			__split --target={paths} --overwrite --no-zero-length --invoke -- \
				is-present --echo --optional -- "${paths[@]}" || return $?
			# now add the fonts
			if [[ ${#option_fonts[@]} -ne 0 ]]; then
				__split --target={paths} --append --no-zero-length --invoke=try -- \
					get-font --every -- "${option_fonts[@]}" || return $?
			fi
			# now handle paths specially as because of fonts, there can be a lot
			local -i count="${#paths[@]}"
			if [[ $count -eq 0 ]]; then
				return 200 # ECUSTOM 200 Not applicable as nothing to do for the inputs
			else
				# if one installs all nerd fonts, it results in 1910 font files, which is too much for `choose`, so use to `gum`
				if [[ $count -gt 100 ]]; then
					# as options are more than a hundred, no default
					setup-util-gum --dependency --quiet="$option_quiet" || return $?
					local selection=()
					__split --target={selection} --no-zero-length --invoke -- \
						gum choose --no-limit --header='Which files to remove?' -- "${fonts[@]}" || return $?
					# if selection is more than a hundred, it'll be too much for `__rm_helper` and `fs-remove`
					if [[ ${#selection[@]} -gt 100 ]]; then
						rm -f -- "${selection[@]}" || return $?
					else
						__rm_helper "${selection[@]}" || return $?
					fi
				else
					# as less than a hundred, default all
					local selection=()
					__split --target={selection} --no-zero-length --invoke -- \
						choose --linger --confirm --multi --question='Which files to remove?' --default-all -- "${fonts[@]}" || return $?
					__rm_helper "${selection[@]}" || return $?
				fi
				return 0
			fi
		else
			return 200 # ECUSTOM 200 Not applicable as nothing to do for this action
		fi
	}

	# =====================================
	# Action

	# transform unsafe into string
	local unsafe_setups_string='' unsafe_fallbacks_string='' order_string=''
	__join --source={unsafe_setups} --target={unsafe_setups_string} --left='[' --right=']' || return $?
	__join --source={unsafe_fallbacks} --target={unsafe_fallbacks_string} --left='[' --right=']' || return $?
	__join --source={option_order} --target={order_string} --left='[' --right=']' || return $?

	# if [[ ${#option_fonts[@]} -ne 0 ]]; then

	# None of these exit codes were suitable:
