	function setup__download {
		local download="$DOWNLOAD" filename filenames=("${DOWNLOAD_FILENAME[@]}") target_path target_paths=("${DOWNLOAD_TARGET_PATH[@]}") bearer_token="$DOWNLOAD_BEARER_TOKEN" archive_extract="$DOWNLOAD_ARCHIVE_EXTRACT" archive_format="$DOWNLOAD_ARCHIVE_FORMAT" archive_glob="$DOWNLOAD_ARCHIVE_GLOB" build_install="$DOWNLOAD_BUILD_INSTALL_EVAL" build_uninstall="$DOWNLOAD_BUILD_UNINSTALL_EVAL" build_glob="$DOWNLOAD_BUILD_GLOB"

