	local -i STATUS__INVALID_ARGUMENT=22               # EINVAL 22 Invalid argupment (e.g. `GO` specified without a <cli>)
	local -i STATUS__ACTION_NOT_FOR_SOURCE=201        # ECUSTOM 20x Not applicable as the action is not relevant to this source
