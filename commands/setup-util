	function __get_path_from_filename {
		local filename="$1"
		# only place in appimage_home if it keeps the appimage extension
		if [[ $filename =~ \.(ttf|otf)$ ]]; then
			local font_dir
			font_dir="$(get-font --only-print-dirs | echo-first-line)" || return $?
			__print_lines "$font_dir/$filename" || return $?
		elif [[ $filename == *'.app' ]]; then
			# macos /Applications/$filename.app
			__print_lines "$HOME/Applications/$filename" || return $?
		elif [[ $filename == *'.appimage' ]]; then
			# macos $HOME/Applications/$filename.appimage
			__mkdirp "$APPIMAGE_HOME" || return $?
			__print_lines "$APPIMAGE_HOME/$filename" || return $?
		elif [[ $option_xdg == 'no' ]]; then
			__elevate_mkdirp '/usr/local/bin' || return $?
			__print_lines "/usr/local/bin/$filename" || return $?
		else
			# macos $HOME/.local/bin/$filename
			__mkdirp "$XDG_BIN_HOME" || return $?
			__print_lines "$XDG_BIN_HOME/$filename" || return $?
		fi
	}

	function __verify_saved_path {
		local path="$1"

		# verify
		if is-missing -- "$path"; then
			__print_style --stderr --error1='Failed to install:' ' ' --path="$path" || return $?
			return 1
		fi

		# check font
		if [[ $path =~ \.(ttf|otf)$ && -f $path ]]; then
			return 0
		else
			# adjust
			fs-own --permissions='+x' -- "$path" || return $?
			fs-dequarantine -- "$path" || return $?

			# check app or cli
			if [[ $path == *'.app' && -d $path ]]; then
				return 0
			elif command-working --elevate="$option_elevate" -- "$path"; then
				return 0
			fi
		fi

		# failure
		__print_style --stderr --error1='Failed to verify:' ' ' --path="$path" || return $?
		# remove so it doesn't interfere with other install methods and other processes
		__remove_present_unique -- "$path" || return $?
		# return failure
		return 1
	}

	function __remove_present_unique {
		local -i all_status=-1 any_status=-1 none_status=0
		local remove_paths=() item
		while [[ $# -ne 0 ]]; do
			item="$1"
			shift
			case "$item" in
			'--all='*) all_status="${item#*=}" ;;
			'--any='*) any_status="${item#*=}" ;;
			'--none='*) none_status="${item#*=}" ;;
			'--')
				remove_paths+=("$@")
				shift $#
				;;
			*) __unrecognised_argument "$item" || return $? ;;
			esac
		done
		if [[ ${#remove_paths[@]} -eq 0 ]]; then
			return "$none_status"
		fi

		# keep only those that exist
		local original_paths=("${remove_paths[@]}")
		__split --target={remove_paths} --no-zero-length --invoke=try -- \
			is-present --echo --optional --elevate="$option_elevate" -- "${remove_paths[@]}" || return $?
		if [[ ${#remove_paths[@]} -eq 0 ]]; then
			return "$none_status"
		elif [[ ${#remove_paths[@]} -eq ${#original_paths[@]} ]]; then
			if [[ $all_status -ge 0 ]]; then
				return "$all_status"
			fi
		elif [[ $any_status -ge 0 ]]; then
			return "$any_status"
		fi

		# remove duplicates
		__unique --source+target={remove_paths} || return $?
		# prefer moving to trash, because trash allows invocations to continue
		# otherwise active invocations will crash, such as `setup-util-bash` --uninstalling the bash it was invoked with
		fs-remove --quiet --no-confirm --trash --delete --elevate="$option_elevate" -- "${remove_paths[@]}" || return $?
	}
