		# 	if [[ -z $installer ]]; then
		# 		any_failure='yes'
		# 		if [[ $option_quiet != 'yes' ]]; then
		# 			__print_style --stderr --notice1='No installer found for: ' --code-notice1="$util" || return $?
		# 		fi
		# 		if [[ $option_first_failure == 'yes' ]]; then
		# 			return 1
