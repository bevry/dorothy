	# if definition and utilities, fail
	if [[ $option_defined == 'yes' && ${#option_utils[@]} -ne 0 ]]; then
		__help 'Cannot specify definitions and utilities at the same time...' || return $?
	# if setup, and no definition nor utils, prompt for which utilities
	elif [[ $option_action == 'setup' && $option_defined == 'no' && ${#option_utils[@]} -eq 0 ]]; then
		# however, only do this for install
		if [[ $option_install == 'yes' && $option_configure != 'no' ]]; then
