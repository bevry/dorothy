			if eval "$option_checker" >/dev/null; then
				is_missing='no'
			else
				is_working='no'
			fi
		fi
		if [[ ${#option_apps[@]} -ne 0 ]]; then
			if get-app --quiet --first -- "${option_apps[@]}"; then
				is_missing='no'
			else
				is_working='no'
			fi
		fi
		if [[ ${#option_clis[@]} -ne 0 ]]; then
			local cli clis_are_missing='no'
			for cli in "${option_clis[@]}"; do
				if __command_exists -- "$cli"; then
					if ! command-working --elevate="$option_elevate" -- "$cli"; then
						is_working='no'
					fi
				else
					clis_are_missing='yes'
					is_working='no'
				fi
			done
			if [[ $clis_are_missing == 'no' ]]; then
				is_missing='no'
			fi
		fi
		if [[ ${#option_fonts[@]} -ne 0 ]]; then
			if get-font --quiet -- "${option_fonts[@]}"; then
				is_missing='no'
			else
				is_working='no'
			fi
		fi
	fi

	# check if already in desired state
	if [[ $can_validate == 'yes' ]]; then
		if [[ $is_missing == 'yes' ]]; then
			# missing, nothing installed
			if [[ $option_action == 'uninstall' ]]; then
				# nothing installed, so no need to uninstall
				__maybe_style --tty --good3="The ❬${option_name}❭ utility was not found. Already uninstalled. ✅" || return $?
				# exit
				return 0
			fi
			# nothing installed, want to install
			if [[ $option_check == 'yes' ]]; then
				# we are just checking if we need to act, no action is necessary
				return 1
			fi
			# if no deps, then cancel
			if [[ $option_deps == 'no' ]]; then
				return 89 # ECANCELED 89 Operation canceled
			fi
			# note that we aren't upgrading, which is used for logging
			option_upgrade='no'
			# perform install
			__maybe_style --tty --header3="The ❬${option_name}❭ utility was not found. Installing automatically... ⏲" || return $?
		elif [[ $option_action == 'uninstall' ]]; then
			# exists, uninstall enabled, want to uninstall
			if [[ $option_check == 'yes' ]]; then
				# we are just checking if we need to act, no action is necessary
				return 1
			fi
			# note that we aren't upgrading, which is used for logging
			option_upgrade='no'
			# perform uninstall
			__maybe_style --tty --header3="The ❬${option_name}❭ utility is marked for uninstall. Uninstalling... ⏲" || return $?
		elif [[ $option_upgrade == 'yes' ]]; then
			# exists, upgrade enabled, want to upgrade
			if [[ $option_check == 'yes' ]]; then
				# we are just checking if we need to act, no action is necessary
				return 1
			fi
			# if no deps, then cancel
			if [[ $option_deps == 'no' ]]; then
				return 89 # ECANCELED 89 Operation canceled
			fi
			# perform upgrade
			__maybe_style --tty --header3="The ❬${option_name}❭ utility is marked for upgrade. Upgrading... ⏲" || return $?
		elif [[ $is_working == 'no' ]]; then
			# exists, not working, want to fix
			if [[ $option_check == 'yes' ]]; then
				# we are just checking if we need to act, no action is necessary
				return 1
			fi
			# if no deps, then cancel
			if [[ $option_deps == 'no' ]]; then
				return 89 # ECANCELED 89 Operation canceled
			fi
			# perform reinstall
			__maybe_style --tty --header3="The ❬${option_name}❭ utility is misbehaving. Reinstalling automatically... ⏲" || return $?
		elif [[ $is_working == 'yes' ]]; then
			# exists, no upgrade, is working, no action necessary
			__maybe_style --tty --good3="The ❬${option_name}❭ utility is already installed. ✅" || return $?
			return 0
		else
			# exists, don't care, proceed anyway
			# used by `setup-util-nerd-fonts` to ensure we check for the correct font
			if [[ $option_check == 'yes' ]]; then
				# we are just checking if we need to act, no action is necessary
				return 1
			fi
			# if no deps, then cancel
			if [[ $option_deps == 'no' ]]; then
				return 89 # ECANCELED 89 Operation canceled
			fi
		fi
	elif [[ $option_check == 'yes' ]]; then
		# we are just checking if we need to act, no action is necessary
		return 1
	fi

	# ensure order
	if [[ ${#option_order[@]} -eq 0 ]]; then
		option_order=("${sources[@]}")
	else
		# custom order, handle ...
		# so [snap ...] means snap first, then everything else, whereas [... apt] means everything then apt
		# as such, the specified sources need to be trimmed from the ... substitution
		# @todo this will currently hard fail if there is two ... occurrences
		local temp_order source inject_source
		temp_order=()
		for source in "${option_order[@]}"; do
			if [[ $source == '...' ]]; then
				# @todo this could become like intersect/union/complement or something
				for inject_source in "${sources[@]}"; do
					if __has --source={option_order} -- "$inject_source"; then
						continue
					else
						temp_order+=("$inject_source")
					fi
				done
			else
				temp_order+=("$source")
			fi
		done
		option_order=("${temp_order[@]}")
	fi

	# for upgrade only, remove existing bin if it exists, as we don't want conflicts if it is deprecated
	# do not do this for uninstall, as we want the actual methods to handle that
	if [[ $option_upgrade == 'yes' ]]; then
		if [[ ${#option_clis[@]} -ne 0 ]]; then
			local cli cli_paths=()
			for cli in "${option_clis[@]}"; do
				cli_paths+=("$XDG_BIN_HOME/$cli") # "/usr/local/bin/$cli"
			done
			__remove_present_unique -- "${cli_paths[@]}" || return $?
		fi
	fi

	# confirm if necessary
	if [[ $option_confirm == 'yes' ]]; then
		if ! confirm --linger --positive --ppid=$$ -- "Do you want to setup the ❬${option_name}❭ utility?"; then
			# we don't want to modify it
			if [[ $option_optional == 'yes' ]]; then
				# it was optional, so success case
				return 0
			else
				# it was not optional, so abort
				return 125 # ECANCELED 125 Operation cancelled
			fi
		fi
	fi

	local had_success='no' had_failure='no' break_early='no' action_current action_past fallbacks=()
	if [[ $option_action == 'uninstall' ]]; then
		action_current='uninstalling'
		action_past='uninstalled'
	elif [[ $option_upgrade == 'yes' ]]; then
		action_current='upgrading'
		action_past='upgraded'
	else
		action_current='installing'
		action_past='installed'
	fi
	function __log_fallback {
		local source="$1"
		__print_style --tty --notice3="The ❬${option_name}❭ utility was unavailable, however it is available by sourcing ❬${source}❭, which we are attempting now... ⏲" || return $?
	}
	function __log_pending {
		local method="${1-}"
		if [[ -n $method ]]; then
			__maybe_style --tty --good3="The ❬${option_name}❭ utility is ${action_current} via ❬${method}❭ ... ⏲" || return $?
		else
			__maybe_style --tty --good3="The ❬${option_name}❭ utility is ${action_current} ... ⏲" || return $?
		fi
	}
	function __log_success {
		local method="${1-}"
		if [[ -n $method ]]; then
			__maybe_style --tty --good3="The ❬${option_name}❭ utility was ${action_past} via ❬${method}❭" || return $?
		else
			__maybe_style --tty --good3="The ❬${option_name}❭ utility was ${action_past}. ✅" || return $?
		fi
	}
	function __log_failure {
		local method="${1-}" suffix=''
		if [[ -n $method ]]; then
			suffix+=" via ❬${method}❭"
		elif [[ $option_optional == 'yes' ]]; then
			suffix+=". ⚠️"
		else
			suffix+=". ❌"
		fi
		if [[ $option_optional == 'yes' ]]; then
			__maybe_style --stderr --notice3="The ❬${option_name}❭ optional utility was not ${action_past}${suffix}" || return $?
		else
			__print_style --stderr --error3="The ❬${option_name}❭ required utility was not ${action_past}${suffix}" || return $?
		fi
		return 0
	}
	function run_source {
		local item source fallback='no'
		while [[ $# -ne 0 ]]; do
			item="$1"
			shift
			case "$item" in
			'--source='*) source="${item#*=}" ;;
			'--fallback') fallback='yes' ;;
			'--'*) __unrecognised_flag "$item" || return $? ;;
			*) __unrecognised_argument "$item" || return $? ;;
			esac
		done
		
		# fallback
		if [[ $fallback == 'yes' ]]; then
			# run fallback
			local fallback_fn="__fallback_$source"
			__log_fallback "$source" || return $?
		fi

		# don't always do `__log_pending` as that will cause all the `200` not applicable ones to be dumped
		local setup_fn setup_status
		local -i setup_status=0
		if [[ $unsafe_sources_string == *"[$source]" ]]; then
			setup_fn="setup__$source"
		else
			setup_fn="__setup__$source"
		fi
		if [[ $use_alt_screen_buffer == 'yes' ]]; then
			# enable job control to not bubble SIGINT up to us
			# such that we can ensure we always restore the default screen buffer, otherwise scrolling will be broken
			__apply_terminal_modifications_now || return $?
			__log_pending "$source" || return $?
			__do --redirect-status={setup_status} --redirect-output=STDERR --copy-stderr={setup_status} --redirect-output=TTY -- "$run_fn" # potentially unsafe eval
			__reset_terminal_modifications_now || return $?
		else
			__do --redirect-status={setup_status} --redirect-output=TTY -- "$run_fn" # potentially unsafe eval
		fi

		# check result
		case "$setup_status" in
		0) 
			# success case
			had_success='yes'
			__log_success "$source" || return $?
			case "$option_action" in
			'setup-install' | 'setup-upstall')
				break_early='yes'
				;;
			esac
			;;
		"$STATUS__SOURCE_FALLBACK")
			# has fallback
			fallbacks+=("$source")
			;;


		
		elif [[ $setup_status -lt 200 ]]; then
			# failure case
			if [[ $use_alt_screen_buffer == 'yes' && -n $setup_status ]]; then
				__print_lines "$setup_status" >&2 || return $? # needs to be print lines, as the trailing line gets trimmed <-- another dorothy branch solves this
			fi
			__log_failure "$source" || return $?
			if [[ $option_action == 'uninstall' ]]; then
				had_failure='yes' # an uninstall failed
			fi
		fi
		# else not applicable case
	}
	function run_sources {
		local source
		# cycle through the sources according to the order
		for source in "${option_order[@]}"; do
			# sanity check
			if [[ -z $source ]]; then
				__help 'An empty order argument was provided:' --newline \
					--variable={option_order} || return $?
			fi
			run_source --source="$source" # unsafe
			if [[ $break_early == 'yes' ]]; then
				break
			fi
		done
		# if nothing was successful, if we are not uninstall, if we allow fallbacks, and if we have fallbacks, then use the fallbacks (install the utility by installing the ecosystem of the utility)
		if [[ $had_success == 'no' && ${#fallbacks[@]} -ne 0 && $option_action != 'uninstall' && $option_fallback == 'yes' &&  ]]; then
			for source in "${fallbacks[@]}"; do
				run_source --source="$source" --fallback # unsafe
				if [[ $break_early == 'yes' ]]; then
					return 0
				fi
			done
		fi
		# all done
		return 0
	}
	run_sources # unsafe
	# if font, refresh the cache
	if [[ ${#option_fonts[@]} -ne 0 ]] && __command_exists -- fc-cache; then
		if [[ $option_quiet == 'yes' ]]; then
			__do --redirect-stdout=TTY -- fc-cache -f || return $?
		else
			__do --redirect-stdout=TTY -- eval-helper --quiet --wrap \
				--pending="$(__print_style --bold='Refreshing font cache...')" \
				--failure="$(__print_style --error='Failed to refresh font cache.')" -- \
				fc-cache -f -v || return $?
		fi
	fi
	# determine failure
	if [[ $option_action == 'uninstall' ]]; then
		# @todo detect if cli is still present, if so, perhaps prompt the user what to do
		if [[ $had_failure == 'no' ]]; then
			__log_success || return $?
		else
			# still some that aren't uninstalled
			__log_failure || return $?
			if [[ $option_optional != 'yes' ]]; then
				return 1
			fi
		fi
	elif [[ $had_success == 'yes' ]]; then
		# at least one installed
		__log_success || return $?
	else
		__log_failure || return $?
		if [[ $option_optional != 'yes' ]]; then
			return 1
		fi
	fi
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	if [[ $* == '--test' ]]; then
		setup_util_test
	else
		setup_util "$@"
	fi
fi
