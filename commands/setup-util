	function __expect_from_stdin { # aka `__expect_specified_amount_of_stdin_lines`
		# `__setup__apt` has another nifty way of doing this, `__setup__flatpak` has another approach as well
		local expect="$1" # any/none/<positive-integer>
		local lines=()
		__split --source=STDIN --target={lines} --no-zero-length || return $?
		case "$expect" in
		'all')
			__print_error '`__expect_from_stdin all` should be `__expect_from_stdin <integer>`' || return $?
			exit 104 # ENOTRECOVERABLE 104 State not recoverable
			;;
		'any')
			if [[ ${#lines[@]} -eq 0 ]]; then
				return 1
			fi
			;;
		'none' | '0')
			if [[ ${#lines[@]} -ne 0 ]]; then
				return 1
			fi
			;;
		*)
			__affirm_value_is_positive_integer "$expect" '__expect_from_stdin <integer>' || return $?
			if [[ ${#lines[@]} -eq $expect ]]; then
				return 1
			fi
			;;
		esac
	}
	function __list_updated_by_evicting_outdated_from_installed {
		# get all upgraded, and use their names to evict, then get all installed, and filter them by upgraded
		local id splat outdated_ids=() other_id updated_rows=() 
		while read id splat; do
			outdated_ids+=("$id")
		done < <(__recurse list-outdated) || return $?
		# if none to evict, then exit early with all installed
		if [[ ${#outdated_ids[@]} -eq 0 ]]; then
			__recurse list-installed || return $?
			return 0
		fi
		# if we have ones to evict, then do so
		while read id splat; do
			for other_id in "${outdated_ids[@]}"; do
				if [[ $id == "$other_id" ]]; then
					continue
				fi
			done
			updated_rows+=("$id $splat")
		done < <(__recurse list-installed) || return $?
		__print_lines "${updated_rows[@]}" || return $?
	}
	function __list_missing_by_evicting_installed {
		# inherit {packages}
		local id splat installed_ids=() other_id missing_ids=()
		while read id splat; do
			installed_ids+=("$id")
		done < <(__recurse list-installed "${packages[@]}") || return $?
		for id in "${packages[@]}"; do
			for other_id in "${installed_ids[@]}"; do
				if [[ $id == "$other_id" ]]; then
					continue
				fi
			done
			missing_ids+=("$id")
		done
		__print_lines "${missing_ids[@]}" || return $?
	}
	function __upstall_to_update_or_install {
		local id splat outdated_ids=() missing_ids=()
		while read id splat; do
			missing_ids+=("$id")
		done < <(__recurse list-missing) || return $?
		while read id splat; do
			outdated_ids+=("$id")
		done < <(__recurse list-outdated) || return $?
		if [[ "${#outdated_ids[@]}" -eq 0 && "${#missing_ids[@]}" -eq 0 ]]; then
			return "$STATUS__PACKAGE_STATE_ALREADY_DESIRED"
		fi
		local -i upstall_exit_status=0
		if [[ "${#outdated_ids[@]}" -ne 0 ]]; then
			__recurse setup-install "${outdated_ids[@]}" || upstall_exit_status=$?
		fi
		if [[ "${#missing_ids[@]}" -ne 0 ]]; then
			__recurse setup-update "${missing_ids[@]}" || upstall_exit_status=$?
		fi
		return "$upstall_exit_status"
	}
	function __filter_for_packages_and_search {
		# inherit {packages} {option_search}
		local id splat result_rows=() keep package search
		while read id splat; do
			keep='no'
			for package in "${packages[@]}"; do
				if [[ $id == "$package" ]]; then
					keep='yes'
					break
				fi
			done
			for search in "${option_search[@]}"; do
				if [[ $id == *"$search"* ]]; then
					keep='yes'
					break
				fi
			done
			if [[ $keep == 'yes' ]]; then
				result_rows+=("$id $splat")
			fi
		done
		__print_lines "${result_rows[@]}" || return $?
	}
	function __recurse {
		if [[ $unsafe_sources_string == *"[$source]" ]]; then
			return "$STATUS__INVALID_RECURSION"
		fi
		# inherits {SETUP_UTIL__SOURCE}
		local __fn="__setup__${SETUP_UTIL__SOURCE}"
		eval "$__fn \"\$@\"" || return $?
	}
	function __is_installed_all_to_any {
		# inherits {SETUP_UTIL__SOURCE}
		local package packages=("$@")
		for package in "${packages[@]}"; do
			if __recurse is-installed-all "$package"; then
				return 0
			fi
		done
		return 1
	}
	function __is_installed_all_to_none {
		# inherits {SETUP_UTIL__SOURCE}
		local packages=("$@")
		if __recurse is-installed-all "${packages[@]}"; then
			return 1
		else
			return 0
		fi
	}

	# -------------------------------------
	# Alpine

	# apk / Alpine Linux
	# @../docs/setup-util/apk.md
	function __parse_apk_list {
		# sed coercion from <https://superuser.com/a/1870448/32418>
		# turns
		# ```
		# zziplib-doc-0.13.80-r1 x86_64 {zziplib} (LGPL-2.0-or-later OR MPL-1.1)
		# zziplib-utils-0.13.80-r1 x86_64 {zziplib} (LGPL-2.0-or-later OR MPL-1.1)
		# ```
		#
		# into
		# ```
		# zziplib-doc 0.13.80-r1
		# zziplib-utils 0.13.80-r1
		# ```
		sed 's/ .*//;s/-\(r[0-9]\+\)$/@@\1/;s/\(.*\)-/\1 /;s/@@/-/' || return $?
	}
	function __parse_apk_yaml_query {
		# turns:
		# ```
		# - name: zziplib-doc
		# version: 0.13.80-r1
		# - name: zziplib-utils
		# version: 0.13.80-r1
		# ```
		#
		# into:
		# ```
		# zziplib-doc 0.13.80-r1
		# zziplib-utils 0.13.80-r1
		# ```
		echo-regexp -gmo '- name:\s+([^\s]+)\s+version: ([^\s]+)' --replace='$1 $2'
	}
	function __setup__apk {
		local packages=("${APK[@]}") repo="$APK_REPO"

		# overwrite
		if [[ $# -ne 0 ]]; then
			packages=("$@")
		fi

		# applicability
		case "$option_action" in
		'invoke' | 'system-clean' | 'system-upgrade') return "$STATUS__ACTION_NOT_FOR_SOURCE" ;;
		esac
		__applicable || return $?

		# action
		case "$option_action" in
		# is-*  ...<package>
		'is-installed-all')
			apk info -e "${packages[@]}" &>/dev/null || return $?
			;;
		'is-installed-any')
			__is_installed_all_to_any "${packages[@]}" || return $?
			;;
		'is-installed-none')
			__is_installed_all_to_none "${packages[@]}" || return $?
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		'list-missing')
			__list_missing_by_evicting_installed || return $?
			;;
		'list-updated')
			__list_updated_by_evicting_outdated_from_installed || return $?
			;;
		'list-'*)
			local search_options=()
			if [[ ${#packages[@]} -ne 0 || ${option_search[@]} -ne 0 ]]; then
				search_options=(--format=yaml --fields=name,version "${packages[@]}") search
				local search
				for search in "${option_search[@]}"; do
					search_options+=("*$search*")
				done
			done
			;;&
		'list-installed')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				apk list --installed | __parse_apk_list || return $?
			else
				apk query --installed "${search_options[@]}" | __parse_apk_yaml_query || return $?
			fi
			;;
		'list-outdated')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				apk --update-cache list --upgradable | __parse_apk_list || return $?
			else
				apk --update-cache query --upgradable "${search_options[@]}" | __parse_apk_yaml_query || return $?
			fi
			;;
		'list-available')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				apk --update-cache list --available | __parse_apk_list || return $?
			else
				apk --update-cache query --available "${search_options[@]}" | __parse_apk_yaml_query || return $?
			fi
			;;
		# setup-* ...<package>
		'setup-'*)
			# `apt --update-cache` avoids the need for ane arlier `apk update` call
			local repository_options=()
			if [[ -n $repo ]]; then
				repository_options+=(--repository "$repo")
			fi
			;;&
		'setup-uninstall')
			__elevate -- apk del "${packages[@]}"
			;;
		'setup-install')
			__elevate -- apk --update-cache "${repository_options[@]}" add "${packages[@]}"
			;;
		'setup-upstall')
			__elevate -- apk --update-cache "${repository_options[@]}" add --upgrade "${packages[@]}"
			;;
		'setup-update')
			__elevate -- apk --update-cache "${repository_options[@]}" upgrade "${packages[@]}"
			;;
		# system-*
		'system-update')
			__elevate -- apk --update-cache upgrade
			;;
		# unhandled
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}

	# -------------------------------------
	# AUR, Arch Linux

	# pacman / Arch Linux / Manjaro
	# @../docs/setup-util/pacman.md
	function __parse_pacman_query {
		# turns:
		# ```
		# local/zstd 1.5.7-3
		#     Zstandard - Fast real-time compression algorithm
		# ```
		# into:
		# ```
		# local/zstd 1.5.7-3
		# ```
		grep --regexp='^[^ ]' || return $?
	}
	function __refresh_pacman {
		__elevate -- pacman --syncy 1>&2 || return $? # --sync --refresh
	}
	function __setup__pacman {
		local packages=()
		if [[ ${#PACMAN[@]} -ne 0 ]]; then
			packages=("${PACMAN[@]}")
		elif [[ ${#AUR[@]} -ne 0 ]]; then
			packages=("${AUR[@]}")
		fi

		# overwrite
		if [[ $# -ne 0 ]]; then
			packages=("$@")
		fi

		# applicability
		case "$option_action" in
		'invoke' | 'system-upgrade') return "$STATUS__ACTION_NOT_FOR_SOURCE" ;;
		esac
		__applicable || return $?

		# prep
		# `pacman-key --init`
		# `pacman --syncy` is `pacman --sync --refresh`

		# action
		case "$option_action" in
		# is-*  ...<package>
		'is-installed-all')
			pacman --query "${packages[@]}" &>/dev/null || return 1
			;;
		'is-installed-any')
			__is_installed_all_to_any "${packages[@]}" || return $?
			;;
		'is-installed-none')
			__is_installed_all_to_none "${packages[@]}" || return $?
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		'list-missing')
			__list_missing_by_evicting_installed || return $?
			;;
		'list-installed')
			if [[ ${#packages[@]} -eq 0 && ${#option_search[@]} -eq 0 ]]; then
				pacman --query || return $?
			else
				{
					if [[ ${#packages[@]} -ne 0 ]]; then
						pacman --query "${packages[@]}" | __parse_pacman_query || return $?
					fi
					if [[ ${#option_search[@]} -ne 0 ]]; then
						pacman --query --search "${option_search[@]}" | __parse_pacman_query || return $?
					fi
				} | echo-unique --stdin || return $?
			fi
			;;
		'list-outdated')
			__refresh_pacman || return $?
			if [[ ${#packages[@]} -eq 0 && ${#option_search[@]} -eq 0 ]]; then
				pacman --query --upgrades | sed 's/ -> / /' || return $?
			else
				{
					if [[ ${#packages[@]} -ne 0 ]]; then
						pacman --query --upgrades "${packages[@]}" | __parse_pacman_query || return $?
					fi
					if [[ ${#option_search[@]} -ne 0 ]]; then
						pacman --query --upgrades --search "${option_search[@]}" | __parse_pacman_query || return $?
					fi
				} | echo-unique --stdin || return $?
			fi
			;;
		'list-updated')
			__list_updated_by_evicting_outdated_from_installed || return $?
			;;
		'list-available')
			if [[ ${#packages[@]} -eq 0 && ${#option_search[@]} -eq 0 ]]; then
				pacman --sync --refresh --search | grep --invert-match --regexp='^ ' || return $?
			else
				{
					if [[ ${#packages[@]} -ne 0 ]]; then
						pacman --sync --print --print-format '%r/%n %v' "${packages[@]}" || return $?
					fi
					if [[ ${#option_search[@]} -ne 0 ]]; then
						pacman --sync --print --print-format '%r/%n %v' --search "${option_search[@]}" || return $?
					fi
				} | echo-unique --stdin || return $?
			fi
			;;
		# setup-* ...<package>
		'setup-'*)
			local repository_options=()
			if [[ -n $repo ]]; then
				repository_options+=(--repository "$repo")
			fi
			;;&
		'setup-uninstall')
			__elevate -- pacman --noconfirm --remove --unneeded --nosave "${packages[@]}" || return $?
			;;
		'setup-install')
			# only install missing packages, as pacman does install+update
			__refresh_pacman || return $?
			local package install_packages=()
			local -i action_status=0
			for package in "${packages[@]}"; do
				if pacman --queryu "$package" &>/dev/null; then
					# already installed
					continue
				else
					# not installed (will install)
					install_packages+=("$package")
				fi
			done
			if [[ ${#install_packages[@]} -ne 0 ]]; then
				__elevate -- pacman --noconfirm --sync --refresh --needed "${install_packages[@]}" || return $?
			else
				action_status="$STATUS__PACKAGE_STATE_ALREADY_DESIRED"
			fi
			return $action_status
			;;
		'setup-upstall')
			# install or update packages to latest version
			__elevate -- pacman --noconfirm --sync --refresh --needed "${packages[@]}" || return $?
			;;
		'setup-update')
			# only update installed packages, as pacman does install+update
			__refresh_pacman || return $?
			local package update_packages=() uninstalled_packages=()
			local -i action_status=0
			for package in "${packages[@]}"; do
				if paman -Qu "$package" &>/dev/null; then
					# installed (outdated)
					update_packages+=("$package")
				elif pacman --query "$package" &>/dev/null; then
					# installed (already updated, as not outdated from earlier)
					continue
				else
					# not installed (unable to be updated)
					__log_unable_to_update_package "$package"
					action_status="$STATUS__PACKAGE_STATE_NOT_APPLICABLE"
				fi
			done
			# update possible first
			if [[ ${#update_packages[@]} -ne 0 ]]; then
				__elevate -- pacman --noconfirm --sync --needed "${update_packages[@]}" || return $?
			elif [[ $action_status -eq 0 ]]; then
				action_status="$STATUS__PACKAGE_STATE_ALREADY_DESIRED"
			fi
			return $action_status
			;;
		# system-*
		'system-update')
			__elevate -- pacman --noconfirm --sync --refresh --sysupgrade || return $?
			;;
		'system-clean')
			__elevate -- pacman --noconfirm --sync --clean || return $?
			;;
		# unhandeld
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}

	# pamac / AUR / Arch Linux
	# @../docs/setup-util/pamac.md
	function __parse_pamac_list_search {
		echo-regexp -gon --regexp='^([^\s]+)\s+([^\s]+)' --replace='$1 $2' || return $?
	}
	function __parse_pamac_checkupdates {
		echo-regexp -go --regexp='^([^\s]+)\s+([^\s]+)\s+->\s+([^\s]+)' --replace='$1 $2 $3' || return $?
	}
	function __setup__pamac {
		local args=() packages=()
		if [[ ${#PAMAC[@]} -ne 0 ]]; then
			packages+=("${PAMAC[@]}")
		elif [[ ${#AUR[@]} -ne 0 ]]; then
			packages+=("${AUR[@]}")
		fi

		# overwrite
		if [[ $# -ne 0 ]]; then
			packages=("$@")
		fi

		# applicability
		if ! is-system --manjaro; then
			return "$STATUS__SOURCE_NOT_FOR_SYSTEM"
		fi
		case "$option_action" in
		'invoke' | 'system-upgrade') return "$STATUS__ACTION_NOT_FOR_SOURCE" ;;
		esac
		__applicable --fallback || return $?

		# action
		case "$option_action" in
		# is-*  ...<package>
		'is-installed-all')
			pamac info "${packages[@]}" || return $?
			;;
		'is-installed-any')
			__is_installed_all_to_any "${packages[@]}" || return $?
			;;
		'is-installed-none')
			__is_installed_all_to_none "${packages[@]}" || return $?
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		'list-missing')
			__list_missing_by_evicting_installed || return $?
			;;
		'list-updated')
			__list_updated_by_evicting_outdated_from_installed || return $?
			;;
		'list-outdated')
			pamac checkupdates -q | __parse_pamac_checkupdates | __filter_for_packages_and_search || return $?
			;;
		'list-'*)
			local search_options=()
			if [[ ${#packages[@]} -ne 0 || ${option_search[@]} -ne 0 ]]; then
				local search
				for search in "${packages[@]}"; do
					search_options+=("^${search}\$")
				done
				for search in "${option_search[@]}"; do
					search_options+=("$search")
				done
			fi
			;;&
		'list-installed')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				pamac list -i | __parse_pamac_list_search || return $?
			else
				pamac search -i "${search_options[@]}" | __parse_pamac_list_search || return $?
			fi
			;;
		'list-available')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				pamac search . | __parse_pamac_list_search || return $?
			else
				pamac search "${search_options[@]}" | __parse_pamac_list_search || return $?
			fi
			;;
		# setup-* ...<package>
		'setup-uninstall')
			__elevate -- pamac remove --no-confirm --unneeded --no-save "${packages[@]}" || return $?
			;;
		'setup-install')
			__elevate -- pamac install --no-confirm --no-upgrade "${packages[@]}" || return $?
			;;
		'setup-upstall')
			__elevate -- pamac install --no-confirm --upgrade "${packages[@]}" || return $?
			;;
		'setup-update')
			__elevate -- pamac update --no-confirm "${packages[@]}" || return $?
			;;
		# system-*
		'system-update')
			__elevate -- pamac update --no-confirm || return $?
			;;
		'system-clean')
			__elevate -- pamac clean --no-confirm || return $?
			;;
		# unhandled
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}
	function __fallback__pamac {
		setup-util-pamac --dependency --quiet="$option_quiet" || return $?
	}

	# -------------------------------------
	# Debian

	# apt / Ubuntu / Debian / Linux Mint / elementary OS / etc
	# @../docs/setup-util/apt.md
	function __apt_key_fetch {
		local key="$1"
		if [[ $key == *'.asc' ]]; then
			# .asc files
			fetch "$key" | gpg --dearmor || return $?
		else
			# .key and unknown files
			fetch "$key" || return $?
		fi
	}
	function __apt_key_add {
		local key="$1" keyring="$2"
		# fetch and convert format, then import with export into correct format
		__apt_key_fetch "$key" | eval-helper --elevate -- gpg \
			--no-default-keyring \
			--keyring="gnupg-ring:$keyring" \
			--import || return $? # uses stdin
		# `gnupg-ring:` prefix creates keyring in apt compatible (legacy) v4 format

		# adjust permission to fix `apt access error` on ubuntu 21.10
		fs-own --elevate --permissions='a+r' -- "$keyring" || return $?
	}
	# turns `apt list` and `apt search` results of:
	# ```
	# zzuf/resolute 0.15-5ubuntu1 amd64
	#   transparent application fuzzer
	#
	# sed/resolute-updates,resolute-security 4.9-2ubuntu1 amd64 [upgradable from: 4.9-2build3]
	#   GNU	 stream editor for filtering/transforming text
	#
	# bash/resolute,now 5.3-2ubuntu1 amd64 [installed]
	#   GNU Bourne Again SHell
	#
	# ```
	#
	# into:
	# ```
	# zzuf 0.15-5ubuntu1
	# sed 4.9-2ubuntu1
	# bash 5.3-2ubuntu1
	# ```
	#
	# edge cases:
	# `zlib1g/resolute,now 1:1.3.dfsg+really1.3.1-1ubuntu3 amd64 [installed]`
	function __parse_apt {
		echo-regexp -ong --regexp='^([^/\s]+)[^\s]+\s+([^\s]+)' --replace='$1 $2' || return $?
	}
	function __parse_apt_installed {
		echo-regexp -ong --regexp='^([^/\s]+)[^\s]+\s+([^\s]+).+?(installed|upgradable)' --replace='$1 $2' || return $?
	}
	function __parse_apt_updated {
		echo-regexp -ong --regexp='^([^/\s]+)[^\s]+\s+([^\s]+).+?installed' --replace='$1 $2' || return $?
	}
	function __parse_apt_upgradeable {
		# turns: `sed/resolute-updates,resolute-security 4.9-2ubuntu1 amd64 [upgradable from: 4.9-2build3]`
		# into: `sed 4.9-2build3 4.9-2ubuntu1`
		echo-regexp -ong --regexp='^([^/\s]+)[^\s]+\s+([^\s]+).+?upgradable from: ([^\]]+)' --replace='$1 $3 $2' || return $?
	}
	function __invoke_apt_without_page_nor_stderr {
		PAGER= apt "$@" 2>/dev/null || return $?
	}
	function __setup__apt {
		local packages=() repo="$APT_REPO" key="$APT_KEY" id="$APT_ID"
		if [[ ${#APT[@]} -ne 0 ]]; then
			packages+=("${APT[@]}")
		elif [[ ${#DEB[@]} -ne 0 ]]; then
			packages+=("${DEB[@]}")
		fi

		# overwrite
		if [[ $# -ne 0 ]]; then
			packages=("$@")
		fi

		# applicability
		if [[ $repo == 'ppa:'* ]] && ! is-system --ubuntu; then
			return "$STATUS__UTILITY_NOT_FOR_SOURCE"
		fi
		case "$option_action" in
		'invoke') return "$STATUS__ACTION_NOT_FOR_SOURCE" ;;
		esac
		__applicable --command='apt-get' || return $?

		# handle `repo` and `key`
		local needs_update=''
		if [[ -n $repo || -n $key ]]; then
			# ensure apt dependencies for repo and key are correctly configured
			setup-util-apt --dependency --quiet="$option_quiet" || return $?
			setup-util-gpg --dependency --quiet="$option_quiet" || return $?

			# check id
			if [[ -z $id ]]; then
				if [[ ${#packages[@]} -gt 1 ]]; then
					__print_error --help='If APT has multiple packages, then APT_ID must be specified.' --newline --variable={invocation} || return $?
					return 1
				else
					# when APT_REPO or APT_KEY are used, then determine APT_ID automatically, and fail if it couldn't be determined
					id="${packages[*]}" # needed for the rm commands
				fi
			fi

			# check key
			if [[ -n $key ]]; then
				if [[ -z $repo ]]; then
					__print_error --help='`APT_KEY` was set but `APT_REPO` was missing.' --newline --variable={invocation} || return $?
					return 1
				fi
				if [[ $key == *'http:'* ]]; then
					__print_error --help='`APT_KEY` was set but contained `http:` instead of `https:`' --newline --variable={invocation} || return $?
					return 1
				fi
				if [[ $repo != *'signed-by={KEY}'* ]]; then
					__print_error --help='`APT_KEY` was set but `APT_REPO` did not contain the literal `signed-by={KEY}` which is needed to automatically reference it.' --newline --variable={invocation} || return $?
					return 1
				fi
			fi

			# cbeck repo
			if [[ -n $repo && $repo == 'deb '* ]]; then
				if [[ $repo != *'arch={ARCH}'* ]]; then
					__print_error --help='`APT_REPO` was set but did not contain the literal `arch={ARCH}` which is needed to automatically reference the current architecture.' --newline --variable={invocation} || return $?
					return 1
				fi
				if [[ $repo == *'http:'* ]]; then
					__print_error --help='`APT_REPO` was set but contained `http:` instead of `https:`' --newline --variable={invocation} || return $?
					return 1
				fi
			fi

			# apply key
			if [[ -n $key ]]; then
				# Deprecated technique is:
				# ```
				# fetch ... | eval-helper --elevate -- apt-key add -
				# ```
				# Modern and working technique is what we do below...
				# which improves upon these incomplete and non-working suggestions:
				# <https://blog.jak-linux.org/2021/06/20/migrating-away-apt-key/>
				# <https://packagecloud.io/blog/what-does-it-mean-to-add-a-repository-to-my-sources/#strongaddaptrepositorystrong>
				# <https://linuxize.com/post/how-to-add-apt-repository-in-ubuntu/>
				# <https://www.techrepublic.com/article/how-to-add-an-openpgp-repository-key-now-that-apt-key-is-deprecated/>
				# <https://stackoverflow.com/a/69015383/130638>
				# <https://askubuntu.com/a/1307181>
				# <https://askubuntu.com/a/1306494>

				# prepare new location
				# /usr/share/keyrings - system packagers
				# /usr/local/share/keyrings - system operator
				__elevate -- mkdir -p --mode=0755 -- /usr/share/keyrings /usr/local/share/keyrings || return $?

				# remove old keys if they exist
				fs-remove --quiet --elevate --no-confirm --optional -- /usr/local/share/keyrings/*"$id"* /etc/apt/trusted.gpg.d/*"$id"* || return $?

				# add the apt key if not uninstalling
				if [[ $option_action != 'uninstall' ]]; then
					local keyring="/usr/local/share/keyrings/$id.gpg"
					__apt_key_add "$key" "$keyring" || return $?
				fi
			fi

			# apply repo
			if [[ -n $repo ]]; then
				# remove old listings if they exist
				fs-remove --quiet --elevate --no-confirm --optional -- /etc/apt/sources.list.d/*"$id"* || :

				# add the repo with appropriate technique for the repo type
				# <https://documentation.ubuntu.com/launchpad/user/explanation/launchpad-api/launchpad-web-service/>
				if [[ $repo == 'ppa:'* ]]; then
					# `ppa` sources are only for ubuntu, and ubuntu has `apt-add-repository`
					# refer to <https://gist.github.com/balupton/1ab5e001b56bd0cd480aa63d9e8ae3fa> for research and manual technique
					# ubuntu check already occurred earlier
					if [[ $option_action != 'uninstall' ]]; then
						__elevate -- apt-add-repository -y --enable-source "$repo" || return $?
					fi
				elif [[ $repo == 'deb '* ]]; then
					# adjust key modifier
					repo="${repo/"{KEY}"/$keyring}" # don't wrap replacement in `"` as that outputs the `"` on bash versions <= 4.2

					# adjust arch modifier
					# `dpkg --print-architecture` outputs `amd64`, `$HOSTTYPE` is `x86_64`, `get-arch` is `x64`
					local dpkg_arch
					dpkg_arch="$(dpkg --print-architecture)" || return $?
					repo="${repo/"{ARCH}"/$dpkg_arch}" # don't wrap replacement in `"` as that outputs the `"` on bash versions <= 4.2

					# adjust release modifier
					local codename
					codename="$(get-system --codename)" || return $?
					repo="${repo/"{RELEASE}"/$codename}" # don't wrap replacement in `"` as that outputs the `"` on bash versions <= 4.2

					# use a non-deprecated technique that supports the deb modifiers
					if [[ $option_action != 'uninstall' ]]; then
						echo-write -- "/etc/apt/sources.list.d/$id.list" <<<"$repo" || return $?
					fi
				else
					# unknown
					__print_error --help='`APT_REPO` was set but was unrecognised:`' --newline --variable={invocation} || return $?
					return 1
				fi
				# to debug failures:
				# sudo apt-add-repository --list
			fi

			# if we added a new repo or key, we need to refresh the apt references
			__elevate -- apt-get update -y || return $?
			needs_update='no'
		fi

		# action
		case "$option_action" in
		# perform updates
		*'-outdated' | *'-updated' | *'-available')
			if [[ $needs_update != 'no' ]]; then
				__elevate -- apt-get update -y || return $?
				needs_update='no'
			fi
			;;&
		# is-*  ...<package>
		'is-installed-'*)
			local results=()
			__split --target={results} --invoke=try -- \
				__invoke_apt_without_page_nor_stderr list --installed "${packages[@]}" || return $?
			;;&
		'is-installed-all')
			if [[ ${#results[@]} -ne ${#packages[@]} ]]; then
				return 1
			fi
			;;
		'is-installed-any')
			if [[ ${#results[@]} -ne 0 ]]; then
				return 1
			fi
			;;
		'is-installed-none')
			if [[ ${#results[@]} -eq 0 ]]; then
				return 1
			fi
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		'list-'*)
			local search_options=()
			if [[ ${#packages[@]} -ne 0 || ${option_search[@]} -ne 0 ]]; then
				local search
				if __are_any_remote "${packages[@]}"; do
					return "$STATUS__NOT_IMPLEMENTED"
				fi
				for search in "${packages[@]}"; do
					search_options+=("^${search}\$")
				done
				for search in "${option_search[@]}"; do
					search_options+=("$search")
				done
			done
			;;&
		'list-installed')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				__invoke_apt_without_page_nor_stderr list --installed "${packages[@]}" | __parse_apt_installed || return $?
			else
				__invoke_apt_without_page_nor_stderr search "${search_options[@]}" | __parse_apt_installed || return $?
			fi
			;;
		'list-outdated')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				__invoke_apt_without_page_nor_stderr list --upgradeable "${packages[@]}" | __parse_apt_upgradeable || return $?
			else
				__invoke_apt_without_page_nor_stderr search "${search_options[@]}" | __parse_apt_upgradeable || return $?
			fi
			;;
		'list-updated')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				__invoke_apt_without_page_nor_stderr list --installed "${packages[@]}" | __parse_apt_updated || return $?
			else
				__invoke_apt_without_page_nor_stderr search "${search_options[@]}" | __parse_apt_updated || return $?
			fi
			;;
		'list-available')
			if [[ ${#search_options[@]} -eq 0 ]]; then
				__invoke_apt_without_page_nor_stderr list "${packages[@]}" | __parse_apt_updated || return $?
			else
				__invoke_apt_without_page_nor_stderr search "${search_options[@]}" | __parse_apt_updated || return $?
			fi
			;;
		# setup-* ...<package>
		'setup-'*)
			# convert urls to local
			local download_index download_url download_filepath
			for download_index in "${!packages[@]}"; do
				download_url="${packages[download_index]}"
				if __are_any_remote "$download_url"; then
					# fetch temp path
					download_filepath="$(fs-make --cache --directory='dorothy' --directory='setup-util' --file="$option_name.deb" --touch)" || return $?
					# download to temp path
					down --filepath="$download_filepath" "$download_url" || return $?
					# apt supports .deb packages for install and uninstall
					packages[download_index]="$download_filepath"
				elif [[ -z $needs_update ]]; then
					needs_update='yes'
				fi
			done
			if [[ $needs_update == 'yes' ]]; then
				__elevate -- apt-get update -y || return $?
				needs_update='no'
			fi
			;;&
		'setup-uninstall')
			# don't use `apt remove --purge` as it is equivalent to `apt purge`
			# and purge removing python will also remove ufw and samba and a whole bunch of other things that depend on python
			# as such, only use `--auto-remove` as that is safer
			__elevate -- apt-get remove --assume-yes --auto-remove "${packages[@]}" || return $?
			;;
		'setup-install')
			__elevate -- apt-get install --assume-yes --fix-broken --no-upgrade "${packages[@]}" || return $?
			;;
		'setup-upstall')
			__elevate -- apt-get install --assume-yes --fix-broken "${packages[@]}" || return $?
			;;
		'setup-update')
			__elevate -- apt-get install --assume-yes --fix-broken --only-upgrade "${packages[@]}" || return $?
			;;
		# system-*
		'system-update')
			# @todo what's the difference between these two?
			__elevate -- apt-get update --assume-yes --fix-broken || return $?
			__elevate -- apt-get full-upgrade --assume-yes || return $?
			;;
		'system-clean')
			__elevate -- apt-get autoremove --assume-yes --purge || return $?
			__elevate -- apt-get autoclean --assume-yes || return $?
			__elevate -- apt-get clean --assume-yes || return $?
			;;
		'system-upgrade')
			if __command_exists -- do-release-upgrade; then
				# check for a new distro release
				if do-release-upgrade -c; then
					# if there is one, then ask the user if they want to upgrade to it
					if [[ $option_confirm == 'no' ]] ||  confirm --linger --negative --ppid=$$ -- 'Upgrade the distribution release?'; then
						__elevate -- do-release-upgrade || return $?
						return $?
					fi
				fi
			fi
			;;
		# unhandled
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}

	# -------------------------------------
	# Flatpak

	# flatpak / Arch Linux / Manjaro
	# @../docs/setup-util/flatpak.md
	function __parse_flatpak_list_search {
		echo-regexp -g --regexp='[ \t]+' --replace=' ' || return $?
	}
	function __setup__flatpak {
		local packages=("${FLATPAK[@]}") repos=("${FLATPAK_REPO[@]}") package repo

		# applicability
		case "$option_action" in
		'invoke' | 'system-clean' | 'system-upgrade') return "$STATUS__ACTION_NOT_FOR_SOURCE" ;;
		esac
		__applicable --fallback || return $?

		# add repos
		if [[ $option_action != 'uninstall' ]]; then
			for repo in "${repos[@]}"; do
				# -u, --user                           Work on the user installation
				# --system                             Work on the system-wide installation (default)
				# --if-not-exists                      Do nothing if the provided remote exists
				__elevate -- flatpak remote-add --if-not-exists "$repo" || return $?
			done
		fi

		# action
		case "$option_action" in
		# is-*  ...<package>
		# flatpak doesn't do any filtering of its list, so we use `__has` to do the filtering
		'invoke' | *'-outdated' | *'-updated' | *'-available')
			__elevate -- flatpak update --appstream || return $?
			;;&
		'invoke')
			local package
			local -i exit_status="$STATUS__PACKAGE_STATE_NOT_APPLICABLE"
			for package in "${packages[@]}"; do
				if __has --source={installed_ids} -- "$package"; then
					exit_status=0
					flatpak run "$package" "${option_args[@]}" || return $? # eval
					break
				fi
			done
			return "$exit_status"
			;;
		'is-'*)
			local installed_ids=()
			__split --target={installed_ids} --no-zero-length --invoke=try -- \
				flatpak list --app --columns=application || return $?
			;;&
		'is-installed-all')
			__has --source={installed_ids} --all -- "${packages[@]}" || return $?
			;;
		'is-installed-any')
			__has --source={installed_ids} --any -- "${packages[@]}" || return $?
			;;
		'is-installed-none')
			if __has --source={installed_ids} --all -- "${packages[@]}"; then
				return 1
			fi
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		'list-installed')
			flatpak list --app --columns=application,version | __parse_flatpak_list_search | __filter_for_packages_and_search || return $?
			;;
		# @todo `outdated` and `updated` would require fetching from the api servers themselves, e.g. flathub server, as flatpak doesn't have support for this yet
		'list-outdated') return "$STATUS__NOT_IMPLEMENTED" ;;
		'list-updated') return "$STATUS__NOT_IMPLEMENTED" ;;
		'list-available')
			# flatpak only accepts a single fuzzy search term, so we have to do multiple queries, and then filter manually
			{
				local search search_results=()
				for search in "${packages[@]}" "${option_search[@]}"; do
					__split --target={search_results} --append --no-zero-length --invoke=try -- \
						flatpak search --columns=application,version "$search" | __parse_flatpak_list_search || return $?
				done
			} | echo-unique --stdin | __filter_for_packages_and_search || return $?
			;;
		# setup-* ...<package>
		'setup-uninstall')
			__elevate -- flatpak uninstall --app --delete-data --assumeyes --noninteractive "${packages[@]}" || return $?
			# remove repos, if there are no more installed packages under it
			for repo in "${repos[@]}"; do
				# --force                 Remove remote even if in use
				# -u, --user              Work on the user installation
				# --system                Work on the system-wide installation (default)
				__elevate -- flatpak remote-delete "$repo" || : # unsure what the exit status is if already in use
			done
			;;
		'setup-install')
			__elevate -- flatpak install --app --assumeyes --noninteractive "${packages[@]}" || return $?
			;;
		'setup-upstall')
			__elevate -- flatpak install --app --or-update --assumeyes --noninteractive "${packages[@]}" || return $?
			;;
		'setup-update')
			__elevate -- flatpak update --app --assumeyes --noninteractive "${packages[@]}" || return $?
			;;
		# system-*
		'system-update')
			__elevate -- flatpak update --app --assumyyes --noninteractive || return $?
			;;
		# unhandled
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}
	function __fallback__flatpak {
		setup-util-flatpak --dependency --quiet="$option_quiet" || return $?
	}

	# -------------------------------------
	# Golang

	# go
	# https://helpmanual.io/man1/go-install/
	function __upstall_go {
		# inherit `packages`
		# install once package at a time as that is what go supports
		# trying ot install multiple errors with `All packages must be provided by the same module`
		local package
		for package in "${packages[@]}"; do
			if [[ $package != *'@'* ]]; then
				# append version if not there
				package="${package}@latest"
			fi
			go install "$package" || return $?
			# ^ don't elevate, not needed, and requires env vars to function
		done
	}
	function __setup__go {
		local packages=("${GO[@]}")

		# applicability
		if [[ ${#option_clis[@]} -eq 0 ]]; then
			# @todo queue an error message
			return "$STATUS__INVALID_ARGUMENT"
		elif [[ -z ${GOPATH-} ]]; then
			return "$STATUS__SOURCE_FALLBACK"
		fi
		case "$option_action" in
		'invoke' | 'system-update' | 'system-clean' | 'system-upgrade') return "$STATUS__ACTION_NOT_FOR_SOURCE" ;;
		'list-installed' | 'list-outdated' | 'list-updated' | 'list-available' ) return "$STATUS__NOT_IMPLEMENTED" ;;
		esac
		__applicable --fallback || return $?

		# prep cli paths as they are common
		local cli cli_paths=()
		for cli in "${option_clis[@]}"; do
			cli_paths+=("$GOPATH/bin/$cli")
		done

		# action
		case "$option_action" in
		# is-*  ...<package>
		# we can't actually detect if each package is installed, only each cli
		# we use `is-present` which uses `is-fs.bash` which supports `<all>/<first>/etc`
		'is-installed-all')
			is-present --all -- "${cli_paths[@]}" || return $?
			;;
		'is-installed-any')
			is-present --first -- "${cli_paths[@]}" || return $?
			;;
		'is-installed-none')
			if ! is-present --all -- "${cli_paths[@]}"; then
				return 1
			fi
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		# unhandled
		# setup-* ...<package>
		'setup-uninstall')
			__remove_present_unique --none="$STATUS__PACKAGE_STATE_ALREADY_DESIRED" -- "${cli_paths[@]}" || return $?
			__upstall_go || return $?
			;;
		'setup-install')
			__remove_present_unique --all="$STATUS__PACKAGE_STATE_ALREADY_DESIRED" -- "${cli_paths[@]}" || return $?
			__upstall_go || return $?
			;;
		'setup-update')
			__remove_present_unique --none="$STATUS__PACKAGE_STATE_NOT_APPLICABLE" -- "${cli_paths[@]}" || return $?
			__upstall_go || return $?
			;;&
		'setup-upstall')
			__upstall_go || return $?
			;;
		# unhandled
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}
	reload_fallbacks+=('go')
	function __fallback__go {
		setup-util-go --dependency --quiet="$option_quiet" || return $?
	}

	# -------------------------------------
	# MacOS

	# brew / Homebrew / macOS
	# @../docs/setup-util/homebrew.md
	# provide `brew` and `cask` separately as:
	# (1) some packages are available as both a formula and as a cask
	# (2) the user (like @balupton) likes brew for formulas, but dislikes casks, as casks always mess with the builtin app's update mechanism
	# but have them use the same handler underneath
	function __is_bash_about_to_wander {
		if ! __has --source={packages} -- 'bash'; then
			return 1
		elif [[ -x "$HOMEBREW_PREFIX/bin/bash" && $BASH_VERSION == "$("$HOMEBREW_PREFIX/bin/bash" -c 'printf "%s" "$BASH_VERSION"')" ]]; then
			if [[ $option_action == 'setup-uninstall' ]]; then
				brew-installed --quiet -- bash || return 1
			else
				brew-installed --quiet --outdated -- bash || return 1
			fi
		fi
	}
	function __warn_if_bash_will_wander {
		if __is_bash_about_to_wander; then
			# moving the homebrew bash to trash, or a temp directory does not work
			# as it seems bash requires the invoked bash path to exist, and if it doesn't, it crashes
			# it is our own script crashing with 137 and not homebrew
			# trapping 137 doesn't work either, one gets [bash: trap: 137: invalid signal specification]
			# the only thing that works is invoking such a script with system bash, however there is no way to do that comprehensively, so we just warn by going back to the default terminal device immediately amd dump the warning, so that the warning persists in context of the need for the update and the result of update which is the upcoming crash
			__reset_terminal_modifications_now || return $?
			__print_style --stderr \
				--notice1='Homebrew may be about to delete the currently running bash executable, which will cause this script to crash with exit status ' --value='137' --newline \
				--notice1='Once crashed, please manually continue by re-running the prior script that you executed.' || return $?
		fi
	}
	function __brew_and_cask {
		local item what='formula'
		while [[ $# -ne 0 ]]; do
			item="$1"
			shift
			case "$item" in
			'--formula') what='formula' ;;
			'--cask') what='cask' ;;
			*) __unrecognised_argument "$item" || return $? ;;
			esac
		done
		if [[ $what == 'formula' ]]; then
			local packages=("${BREW[@]}") taps=("${BREW_TAP[@]}") tap
		else
			local packages=("${CASK[@]}") taps=("${CASK_TAP[@]}") tap
		fi

		# applicability
		if ! __is_macos; then
			return "$STATUS__SOURCE_NOT_FOR_SYSTEM"
		fi
		if ! __is_brew; then
			return "$STATUS__SOURCE_FALLBACK"
		fi
		case "$option_action" in
		'invoke' | 'system-upgrade') return "$STATUS__ACTION_NOT_FOR_SOURCE" ;;
		esac
		__applicable --fallback || return $?

		# taps
		for tap in "${taps[@]}"; do
			brew tap "${opts[@]}" "$tap" || return $?
		done

		# action
		case "$option_action" in
		# is-*  ...<package>
		# @todo `--<all|any|none>` need to be implemented, could use `__expect_from_stdin`
		'is-installed-all')
			brew-installed --type="$what" --quiet --all -- "${packages[@]}" || return $?
			;;
		'is-installed-any')
			brew-installed --type="$what" --quiet --any -- "${packages[@]}" || return $?
			;;
		'is-installed-none')
			brew-installed --type="$what" --quiet --none -- "${packages[@]}" || return $?
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		'list-installed')
			if [[ ${#option_search[@]} -eq 0 ]]; then
				brew-installed --type="$what" -- "${packages[@]}" || return $?
			else
				brew-installed --type="$what" | __filter_for_packages_and_search || return $?
			fi
			;;
		'list-outdated')
			if [[ ${#option_search[@]} -eq 0 ]]; then
				brew-installed --type="$what" --outdated -- "${packages[@]}" || return $?
			else
				brew-installed --type="$what" --outdated | __filter_for_packages_and_search || return $?
			fi
			;;
		'list-updated')
			if [[ ${#option_search[@]} -eq 0 ]]; then
				brew-installed --type="$what" --updated -- "${packages[@]}" || return $?
			else
				brew-installed --type="$what" --uupdated | __filter_for_packages_and_search || return $?
			fi
			;;
		'list-available')
			if [[ ${#packages[@]} -eq 0 && ${#option_search[@]} -eq 0 ]]; then
				return "$STATUS__NOT_IMPLEMENTED"
			else
				local search_options=() search # distro
				# --alpine                     Search for text in the given database.
				# --repology                   Search for text in the given database.
				# --macports                   Search for text in the given database.
				# --fink                       Search for text in the given database.
				# --opensuse                   Search for text in the given database.
				# --fedora                     Search for text in the given database.
				# --archlinux                  Search for text in the given database.
				# --debian                     Search for text in the given database.
				# --ubuntu                     Search for text in the given database.
				# distro="$(get-system --distro)" || return $?
				# case "$distro" in
				# 'alpine' | 'opensuse' | 'fedora' | 'debian' | 'ubuntu') search_options+=("--$distro") ;;
				# 'arch') search_options+=("--$distro") ;;
				# esac
				# ^ @todo needs testing - perhaps it isn't needed
				# packages as whole words regexp
				for search in "${packages[@]}"; do
					search_options+=("/^$search$/")
				done
				# search as globs
				for search in "${option_search[@]}"; do
					search_options+=("*$search*")
				done
				# only outputs package names andnothing else
				brew search --"$what" "${search_options[@]}" | cat || return $?
			fi
			;;
		# setup-* ...<package>
		'setup-uninstall' | 'setup-upstall' | 'setup-update')
			# if we risk removing the current bash, warn
			__warn_if_bash_will_wander || return $?
			;;&
		'setup-uninstall')
			brew_potential_removal='yes'
			;;
		'setup-install')
			HOMEBREW_NO_INSTALL_UPGRADE=1 brew install --"$what" --yes "${packages[@]}" || return $?
			;;
		'setup-upstall')
			brew_potential_removal='yes'
			brew update || return $?
			brew install --"$what" --yes "${packages[@]}" || return $?
			;;
		'setup-update')
			brew_potential_removal='yes'
			brew update || return $?
			brew upgrade --"$what" --yes "${packages[@]}" || return $?
			;;
		# system-*
		'system-update')
			brew update || return $?
			brew upgrade || return $?
			;;
		'system-clean')
			local -i clean_exit_status=0
			# fix common permission errors:
			# ```
			# Error: Could not cleanup old kegs! Fix your permissions on:
			# /usr/local/Cellar/go/1.17.2
			# ```
			if [[ -n ${HOMEBREW_CELLAR-} ]]; then
				if [[ -d "$HOMEBREW_CELLAR/go" ]]; then
					fs-own --ugx -- "$HOMEBREW_CELLAR/go" || clean_exit_status=$?
					# bin, libexec, and many other directories contain executables, so just make it all executable
				fi
			fi
