					dorothy-config 'setup.bash' -- \
						--field='SETUP_UTILS' --array="$fodder" || return $?
				fi
			else
				# apply
				option_utils=("${SETUP_UTILS[@]}")
			fi
		elif [[ ${#option_utils[@]} -eq 0 ]]; then
			# fail
			__help --help='No <utility>s nor <...defition> specified for the setup action.' || return $?
			return 0
		fi
	fi

	if [[ ${#option_utils[@]} -ne 0 ]]; then
		# cycle through the utilities, and check if there are any aliases
		local util alias util_aliases=() util_commands=()
		# convert utils into aliases and commands
		for util in "${option_utils[@]}"; do
			# trim version suffix
			# ruby@3 => ruby
			alias="${alias%%@*}"
			# trim tap prefix
			# clementtsang/bottom/bottom => bottom
			alias="${alias##*/}"
			# if alias has a space character, then it must have flags or superfluous spaces, trim them
			if [[ $alias == *' '* ]]; then
				# --classic code --classic => code
				# (^| ) matches either start of the line, or a space character
				# -[^ ]+ matches a dash followed by one or more non-space characters
				# so this is what converts the `--classic` flag into ``
				# then we trim whitespace at the start and end
				# @todo replace with pure bash to prevent slowdown
				alias="$(echo-regexp -g '(^| )-[^ ]+' '' -- "$alias" | echo-trim-each-line --stdin)" || return $?
			fi
			# add
			util_aliases+=("$alias")
			util_commands+=("setup-util-$alias")
		done
		if __command_missing -- "${util_commands[@]}"; then
			# associative
			if [[ $BASH_HAS_NATIVE_ASSOCIATIVE_ARRAY == 'yes' ]]; then
				declare -A utils_associative_array
				function __add_alias_command {
					local alias="$1" command="$2"
					utils_associative_array["$alias"]="$command"
				}
				function __get_alias_command {
					local alias="$1"
					printf '%s' "${utils_associative_array["$alias"]-}" || return 0
				}
			else
				local aliases=() alias_commands=()
				function __add_alias_command {
					local alias="$1" command="$2"
					aliases+=("$alias")
					alias_commands+=("$command")
				}
				function __get_alias_command {
					local alias="$1"
					local -i index
					for index in "${!aliases[@]}"; do
						if [[ ${aliases[index]} == "$alias" ]]; then
							printf '%s' "${alias_commands["$index"]-}" || return 0
						fi
					done
				}
			fi
			# load aliases
			local database="$DOROTHY/config/setup-util.dat" alias command
			while IFS=' ' read -rd $'\n' alias command; do
				if [[ -z $alias && -z $command ]]; then
					# skip empty lines
					continue
				elif [[ -z $alias || -z $command ]]; then
					# if one of them is missing, then it's an invalid line
					__print_error --code="$alias" ' => ' --code="$command" ' ❌ ' --error='invalid database entry' || return $?
					return 79 # EFTYPE 79 Inappropriate file type or format
				elif [[ "setup-util-$alias" == "$command" ]]; then
					# alias not needed
					__print_error --code="$alias" ' => ' --code="$command" ' ❌ ' --error='no need for the alias' || return $?
					return 79 # EFTYPE 79 Inappropriate file type or format
				fi
				# both are present, it is a valid line
				__add_alias_command "$alias" "$command"
			done
			# replace the util commands with the resolved alias commands
			util_commands=()
			for alias in "${util_aliases[@]}"; do
				command="setup-util-$alias"
				if __command_exists -- "$command"; then
					util_commands+=("$command")
				else
					command="$(__get_alias_command "$alias")" || return $?
					if [[ -z $command ]]; then
						# validation for empty done later
						util_commands+=('')
					elif __command_exists -- "$command"; then
						util_commands+=("$command")
					else
						# the alias command is missing, error now
						__print_error --code="$alias" ' => ' --code="$command" ' ❌ ' --error='the aliased command does not exist' || return $?
						return 79 # EFTYPE 79 Inappropriate file type or format
					fi
				fi
			done
		fi
		# now process the action on the `util_commands`

		# else
		# 	# @todo this may be permissible if multiple utilities provide
		# 	__print_error --help='No `setup-util-*` command exists for the utility ' --code="$alias" || return $?
		# 	return 2 # ENOENT 2 No such file or directory
		# fi

		# # handle each utility
