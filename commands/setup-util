		# 	elif "$installer" --quiet="$option_quiet"; then # eval
		# 		if [[ $option_first_success == 'yes' ]]; then
		# 			return 0
		# 		fi
		# 	else
		# 		any_failure='yes'
		# 		if [[ $option_first_failure == 'yes' ]]; then
		# 			return 1
		# 		fi
		# 	fi
		# done

		# # check for failures
		# [[ $any_failure == 'no' ]] || return $?

		# if __command_exists -- "$cmd"; then
		# 	"$cmd" "${option_args[@]}" || : # don't fail everything if one fails
		# else
		# 	# can't use -EOF, as we want to print spacing
		# 	__print_error \
		# 		--help="Unable to install \`$item\`, as \`$cmd\` doesn't exist." --newline \
