			source "$DOROTHY/sources/config.sh" # unsafe

			# setup.bash provides:
			local SETUP_UTILS=()             # this would be better as `SETUP_UTIL_INSTALL` but historical usage keeps it `SETUP_UTILS`
			load_dorothy_config 'setup.bash' # unsafe

			# reconfigure if no existing configuration, or if reconfiguration is desired
			if [[ ${#SETUP_UTILS[@]} -eq 0 || $option_configure == 'yes' ]]; then
