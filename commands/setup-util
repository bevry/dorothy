	# `pamac checkupdates` options (outputs a list of packages with updates available):
	# --builddir <dir> : build directory (use with --devel), if no directory is given the one specified in pamac.conf file is used
	# --aur, -a        : also check updates in AUR
	# --no-aur         : do not check updates in AUR
	# --quiet, -q      : only print one line per update
	# --devel          : also check development packages updates (use with --aur)
	# --no-devel       : do not check development packages updates
	# `pacmac checkupdates -q` results:
	# zlib  1:1.3.1-2 -> 1:1.3.2-3
	#
	# `pamac update|upgrade` options:
	# --force-refresh       : force the refresh of the databases
	# --no-refresh          : do not refresh the databases
	# --enable-downgrade    : enable package downgrades
	# --disable-downgrade   : disable package downgrades
	# --download-only, -w   : download all packages but do not install/upgrade anything
	# --dry-run, -d         : only print what would be done but do not run the transaction
	# --ignore <package(s)> : ignore a package upgrade, multiple packages can be specified by separating them with a comma
	# --overwrite <glob>    : overwrite conflicting files, multiple patterns can be specified by separating them with a comma
	# --no-confirm          : bypass any and all confirmation messages
	# --aur, -a             : also upgrade packages installed from AUR
	# --no-aur              : do not upgrade packages installed from AUR
	# --devel               : also upgrade development packages (use with --aur)
	# --no-devel            : do not upgrade development packages
	# --builddir <dir>      : build directory (use with --aur), if no directory is given the one specified in pamac.conf file is used
	function __parse_pamac_search {
		echo-regexp -go --regexp='^([^\s]+)\s+([^\s]+)' --replace='$1 $2' || return $?
	}
	function __setup__pamac {
		local args=() packages=()
		if [[ ${#PAMAC[@]} -ne 0 ]]; then
			packages+=("${PAMAC[@]}")
		elif [[ ${#AUR[@]} -ne 0 ]]; then
			packages+=("${AUR[@]}")
		fi

		# applicability
		__applicable --fallback || return $?

		# action
		case "$option_action"; in
		# is-*  ...<package>
		'is-installed-all') || return 1 ;;
		'is-installed-any') __is_installed_all_to_any "${packages[@]}" || return $? ;;
		'is-installed-none') __is_installed_all_to_none "${packages[@]}" || return $? ;;
		# list-*
		'list-installed') pamac list -i | echo-regexp -go --regexp='^([^\s]+)\s+([^\s]+)' --replace='$1 $2' || return $? ;;
		'list-outdated') pamac checkupdates -q | echo-regexp -go --regexp='^([^\s]+)\s+([^\s]+)\s+->\s+([^\s]+)' --replace='$1 $2 $3' || return $? ;;
		'list-updated') return "$STATUS__NOT_IMPLEMENTED" ;;
		'list-available') pamac search . | __parse_pamac_search || return $? ;;
		# search-* ...<package> --search=...<search>
		'search-'*)
			# regexp
			local search_options=() search
			for search in "${packages[@]}"; do
				search_options+=("^${search}\$")
			done
			for search in "${option_search[@]}"; do
				search_options+=("$search")
			done
			;;&
		'search-installed' ) pamac search -i | __parse_pamac_search || return $?;;
		'search-outdated') return "$STATUS__NOT_IMPLEMENTED" ;;
		'search-updated') return "$STATUS__NOT_IMPLEMENTED" ;;
		'search-available') pamac search "${search_options[@]}" | __parse_pamac_search || return $?;;
		# setup-* ...<package>
		'setup-uninstall') __elevate -- pamac remove --no-confirm --unneeded --no-save "${packages[@]}" || return $? ;;
		'setup-install') __elevate -- pamac install --no-confirm --no-upgrade "${packages[@]}" || return $? ;;
		'setup-upstall') __elevate -- pamac install --no-confirm --upgrade "${packages[@]}" || return $? ;;
		'setup-upgrade') __elevate -- pamac update --no-confirm --upgrade "${packages[@]}" || return $? ;;
		'setup-upgrade-all');;
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}
	function __fallback__pamac {
		if ! is-system --manjaro; then
			return "$STATUS__SYSTEM_NA"
		fi
		__log_fallback 'Pamac' || return $?
		setup-util-pamac --dependency --quiet="$option_quiet" || return $?
	}

