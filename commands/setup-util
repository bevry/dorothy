			elif [[ ${#option_clis[@]} -ne 0 ]]; then
				filenames=("${option_clis[@]}")
			else
				__print_error --help='`DOWNLOAD` requires `DOWNLOAD_FILENAME` or <cli> or <font>' || return $?
				return 22 # EINVAL 22 Invalid argument
