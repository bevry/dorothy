		function __reset_terminal_modifications_now { :; }
		function __reset_terminal_modifications_on_exit { :; }
		function __apply_terminal_modifications_now { :; }
	fi

	# check if exists
	local can_validate='' is_working='' is_missing=''
	if [[ ${#option_clis[@]} -ne 0 || ${#option_apps[@]} -ne 0 || -n $option_checker || ${#option_fonts[@]} -ne 0 ]]; then
		can_validate='yes'
		is_working='yes'
