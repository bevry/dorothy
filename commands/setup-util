			done
			;;&
		'setup-install')
			scoop install "${packages[@]}" || return $?
			;;&
		'setup-upstall')
			local package
			for package in "${packages[@]}"; do
				if __recurse
			;;&
		'setup-install' | 'setup-upstall')
			# link to the scoop .exe shim
			# get the scoop .exe shims for the packages
			local scoop_exe_paths=()
			__split --target={scoop_exe_paths} --no-zero-length --invoke=try -- \
				__scoop_package_to_path "${packages[@]}" || return $?
