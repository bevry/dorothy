				down "$url" \
					--quiet="$option_quiet" \
					--archive-extract="$archive_extract" \
					--archive-format="$archive_format" \
					--archive-glob="$archive_glob" \
					--directory="$download_directory" \
					--filepath="$download_filepath" \
					--bearer-token="$bearer_token" || return $?
			done
		}

		# determine path
