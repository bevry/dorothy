function setup_util() (
	source "$DOROTHY/sources/bash.bash"

	# when running via fresh source environment, ensure that environment gets configured
	if [[ -z ${DOROTHY_ENVIRONMENT-} ]]; then
		source "$DOROTHY/sources/environment.sh"
	fi

	# helpers
	function __maybe_style {
		if [[ $option_quiet != 'yes' ]]; then
			__print_style "$@" || return $?
		fi
	}
	function __columns_to_csv {
		tr $'\t' ',' || return $?
	}

	# app paths
	local app_search_paths=() system
	if __is_macos; then
		system='macos'
		app_search_paths+=(
			"$HOME/Applications"
			'/Applications'
			'/Applications/Setapp'
			'/Applications/Utilities'
			'/System/Applications'           # TextEdit
			'/System/Applications/Utilities' # Terminal
			'/System/Library/CoreServices'   # Finder
		)
	elif __is_windows; then
		# @todo now that nested exe searching is there, consider adding the Windows WSL paths for nested exe searching
		system='windows'
	elif __is_linux; then
		# could also do this `rg '<app human name>' /usr/share/applications`  however, perhaps just forcing correct names for *.desktop lookup is best
		app_search_paths+=(
			"$HOME/Applications"
			"$APPIMAGE_HOME"
			'/usr/share/applications'
			"$DATA_DIR/applications"
			"$XDG_DATA_HOME/applications"
		)
		system='linux'
		__evict --source+target={app_search_paths} --optional --every --value=''
		__unique --source+target={app_search_paths}
	fi

	# font paths
	local font_search_paths=()
	if __is_macos; then
		font_search_paths+=(
			"$HOME/Library/Fonts"
		)
	else
		font_search_paths+=(
			"$XDG_DATA_HOME/fonts"
			"$DATA_DIR/fonts"
			'/usr/local/share/fonts'
			'/usr/share/fonts'
		)
		__unique --source+target={font_search_paths}
	fi

	function __join_for_squigglies {
		# handle single vs multiple items differently regarding squiglies
		if [[ $# -gt 1 ]]; then
			# transform `desktop` and `appimage` to `{desktop,appimage}` which means `desktop` or `appimage`
			# trunk-ignore(shellcheck/SC2034)
			local alts=("$@") result=''
			__unique --source+target={alts} || return $?
			__join --source={alts} --target={result} --between=',' || return $?
			__print_string "{$result}" || return $?
		else
			# retain `desktop` as `desktop`, do not add squiglies, and `{desktop}` is `{desktop}` not `desktop`
			__print_string "$*" || return $?
		fi
	}

	function __get_bin_paths {
		local name="$1" lower names=() extension seek=()
		lower="$(__get_lowercase_string "$name")" || return $?
		names+=("$name")
		if [[ $name != "$lower" ]]; then
			names+=("$lower")
		fi
		seek+=("${names[@]}")
		for extension in "${bin_extensions[@]}"; do
			for name in "${names[@]}"; do
				seek+=("$name.$extension")
			done
		done
		type -Pa "${seek[@]}" || return $?
	}
	function __get_app_paths {
		local name="$1" lower sup mid sub
		lower="$(__get_lowercase_string "$name")" || return $?
		sup="$(__join_for_squigglies "${app_search_paths[@]}")" || return $?
		mid="$(__join_for_squigglies "$name" "$lower")" || return $?
		sub="$(__join_for_squigglies "${app_extensions[@]}")" || return $?
		expand-path -- "$sup/**/$mid.$sub" || return $?
	}

	# prefer precompiled with autoupdate with extras
	# extras = man packages, autocompletes, etc
	local sources=(
		# +precompiled +compiling +autoupdate +extras
		brew
		cask

		# +precompiled +compiling +autoupdate +extras
		apt    # debian package manager (includes DEB, successor to aptitude)
		apk    # alpine package manager (includes APK)
		zypper # opensuse package manager (includes RPM, supports YaST2)
		dnf    # fedora package manager (includes RPM, successor to yum)
		yum    # fedora package manager (includes RPM, predecessor to dnf)

		# +precompiled[containers] +autoupdate +extras
		soar    # appimage package system, dependencies are within
		snap    # dependencies are within the snap
		flatpak # dependencies are their own flatpaks, but everything is precompiled

		# +precompiled[first-class AUR support] +autoupdate +extras
		pamac  # manjaro package manager (includes AUR): GUI+CLI, vala, wraps libalpm, snap, flatpak: https://gitlab.manjaro.org/applications/pamac/
		pacman # arch package manager (includes AUR): CLI, c, wraps libalpm: https://wiki.archlinux.org/title/pacman

		# +precompiled[third-party AUR wrappers] +autoupdate +extras
		# https://wiki.archlinux.org/title/AUR_helpers
		# https://wiki.manjaro.org/index.php?title=Pamac
		# https://wiki.manjaro.org/index.php/Arch_User_Repository
		# https://itsfoss.com/paru-aur-helper/
		# https://itsfoss.com/best-aur-helpers/
		# yay      # GUI, go, wraps pacman: https://github.com/Jguer/yay
		# paru     # CLI, rust, wraps pacman: https://github.com/Morganamilo/paru
		# pakku    # CLI, nim, wraps pacman: https://github.com/kitsunyan/pakku
		# aurutils # CLI, shell, wraps pacman: https://github.com/AladW/aurutils

		# +precompiled -autoupdate +extras
		#appimage # our own appimage support, dependencies are within
		dpkg # prefer apt wrapper
		rpm  # prefer dnf wrapper, note this is also available on opensuse however zypper is preferred there

		# +precompiled -autoupdate -extras
		download # remote download from url
		nvm

		# +compiling +autoupdate
		cargo # prefer over go
		go

		# +jit +autoupdate
		npm # prefer over python and ruby
		gem # prefer over python
		uv  # there use to be support for pip and pipx here, but it was dropped, as uv is superior

		# +precompiled +autoupdate
		mas

		# macos, +compiling, +autoupdate
		# port

		# solaris/bsd, unknown features
		# pkgin
		# pkgadd
		# pkg

		# unknown features
		# cabal
		# conda
		# emerge
		# eopkg
		# guix
		# nix
		# xbps
		# urpmi

		# disable/removed as no documentation
		# pkgutil
		# pkgman
		# huber
		# eget
		# stack
		# kiss

		# now prefer these custom methods, -autoupdate
		installer # local or remote installer
		custom    # invoke a function/command/script

		# A note on Windows
		# Dorothy only supports WSL
		# Which `is-system --linux` and `is-system --windows` and `is-system --wsl` will all be true.
		# Utilities should be installed via the Linux options, as utilities compiled for Windows is compiled for a Windows NOT WSL environment, and expects Windows and outputs conventions, such as Windows-style file paths and line endings. As such `.exe`s will fail on WSL unless wrapped in `eval-wsl` and with line endings etc handled.
		# Applications however, should be  installed via Scoop or Winget only, as WSL does not have the necessary privileges to install applications itself, as it cannot run as a Windows administrator. As such, do not write INSTALLER and EVAL scripts for `.msi`s etc.
		# In summary, if <app> and if Windows and if no <cli>, then you should exclude all but scoop and winget. Perhaps later `setup-util` will do this exclusion ourself.
		# Note that applications can still be installed on  headless environments, such as Plex Media Server.

		# Prefer scoop before winget, is +exposed +shared +precompiled, +autoupdate, however binaries are exposed to WSL but expect Windows conventions, such as Windows paths, CRLF line endings, etc; this can be worked around for things like `deno` with `eval-wsl`, or with `jq` with `bash.bash:__jq`, however things like `ripgrep` it is too involved, so bump this way later, to prefer internal-WSL sources, then Windows sources
		scoop # installs exes to consistent path location

		# Prefer winget after scoop, is +precompiled +autoupdate, however requires environment to be reloaded, and requires manual .exe handling
		winget # installs apps to windows, installs exes to windows, paths inherited but custom

		# choco/chocolatey/cinst is not supported as it does not support WSL: <https://gist.github.com/balupton/f1c70ec7420e7cdea1aedf6bdb898589>

		# undesired
		generic # generic uninstaller, for cleaning up leftovers
	)

	# =====================================
	# Arguments

	local invocation="$0 $*"
	function __help {
		# trunk-ignore(shellcheck/SC2034)
		local source_options=() source_options_rendered='' sources_rendered
		# prevent endless `setup-util` recursion
		if __command_exists -- deno; then
			__split --target={source_options} --no-zero-length --invoke -- \
				echo-regexp -smgf '.+# [<]options-for-sources[>]\s+|\s+# [<]/options-for-sources[>].+|\t|local ' '' <"${BASH_SOURCE[0]}" || return $?
			__join --source={source_options} --target={source_options_rendered} --left='* ' --style=code --between=$'\n' || return $?
		else
			source_options_rendered="$(__print_error --help='`deno` is required to display the source options; install it with: `setup-util-deno`' 2>&1)" || return $?
		fi
		__join --source={sources} --target={sources_rendered} --between=', ' --style=code || return $?

		# add invocation for debugging if error
		if [[ $# -ne 0 ]]; then
			set -- "$@" $'\nFailed invocation: ' --code="$invocation" || return $?
		fi

		# output the help
		__print_help "$@" <<-EOF || return $?
			ABOUT:
			Setup a utility on your system. Supports Linux, macOS, Windows. Supports direct sources (website, github) and indirect sources (package managers, app stores).

			USAGE:
			Setup a utility from sources:
			\`setup-util [...options] <...sources>\`

			Setup a predefined utility from its \`setup-util-*\` command:
			\`setup-util [...options] ...<utility>\`

			Invoke a predefined utility from its \`setup-util-*\` command:
			\`setup-util [...options] invoke <utility> [-- <...arguments>]\`

			EXAMPLES:
			\`\`\`
			# different ways to install bottom
			setup-util --name='bottom' --cli='btm' AUR='bottom-bin' BREW='bottom' CARGO='bottom'
			setup-util-bottom # directly calls the comprehensive bottom utility setup command
			setup-util bottom # defers to \`setup-util-bottom\`
			setup-util btm    # defers to \`setup-util.dat\` Dorothy configuration file, which defers it to \`setup-util-bottom\`

			# invoke bottom
			setup-util invoke bottom
			setup-util invoke bottom -- --help # passing \`--help\` argument to bottom's \`btm\` CLI
			\`\`\`

			OPTIONS:
			These setup options are installation actions, and will disable prior uninstallation actions:
			@todo remove the precedence thing, and error if additional actions are specified
			@todo figure out upstall/upgrade inheritance for --transpose/npm/ecosystems/etc
			@todo merge get-app/set-app/__iterate options for handling multiple utilities/installations/etc

			[--]setup
			    Alias for <upstall> and <configure>.
			    Effect is, if enabled, ensure installed, upgraded, and configured.
			[--]install
			    If enabled, if the utility is not installed, install it.
			    ! This is the default action if no other action is provided.
			[--]upgrade | [--]update
			    If enabled, if the utility is installed, and if it is outdated, reinstall it.
			[--]upstall
			    Alias for <install> and <upgrade>.
			    Effect is, if enabled, if the utility is not installed, it will be installed; if the utility is installed, and it is outdated, it will upgraded.

			These setup options are uninstallation actions, and will disable prior installation actions:

			[--]uninstall
			    If enabled, if the utility is installed, uninstall it.

			These setup options are configuration actions, and will retain any existing installation or uninstallation action:

			[--][re]configure
			    If enabled, or if unset and an installation or uninstallation action will occur, then configure the resultant installation/uninstallation.
			    ! If empty, defaults to the \`SETUP_UTIL__CONFIGURE\` environment variable; which this option will export.

			These special options are for shallow actions, and will take precedence over other actions:

			[--]help | -h
			    Output this help documentation.

			[--]invoke [...<utility>] [[--] <...arguments>]
			    If enabled, invoke the <utility>.
			    Returns the invocations exit status.

			[--]get-installer [[--] ...<utility>]
			    Outputs the command to install <util>.
			    If no command, return failure status.

			[--]is-shallow
			    Returns [0] if the action options intent is one of these shallow actions (1), or (2) if the setup action state is able to be shallowly detected (e.g. <cli>, <app>, or <font> is provided to detect if the utility to be installed is already installed).
			        --deep
			            If enabled, disable the shallow setup action state detection of (2) and instead check state with each source.
			    Returns [1] otherwise.
			[--]shallow
			    Perform the shallow action if specified, otherwise simply return [0].

			These special options are for actions that can be shallow or deep, and will take precedence over other actions:

			[--]get-installed [--search=...<search>] [[--] ...<utility>]
			    Get the details in JSON of installed packages. With optional filtering by search or utilities.
			    \`\`\`
			    [
			        {"source":"flatpak","id":"com.visualstudio.code","path":"...","name":"...","version":"...",...},
			        {"source":"cask","id":"visual-studio-code","path":"...","name":"...","version":"...",...},
			        {"source":"desktop","id":"code.desktop","path":"...","name":"...","version":"...",...}
			    ]
			    \`\`\`

			[--]is-installed
			    Returns [0] if the <utility>s are installed.
			    Returns [1] otherwise.
			[--]is-uninstalled
			    Returns [0] if the <utility>s are uninstalled.
			    Returns [1] otherwise.

			[--]is-setup
			    Returns [0] if the action options intent is to install, uninstall, or configure; utility checks are not performed.
			    Returns [1] otherwise.
			[--]is-install
			    Returns [0] if the action options intent is to install, uninstall, or configure; utility checks are not performed.
			    Returns [1] otherwise.
			[--]is-uninstall
			    Returns [0] if the action options intent is to install, uninstall, or configure; utility checks are not performed.
			    Returns [1] otherwise.

			These special options are actions that are only deep, will take precedence over other actions:

			[--]search [--search=...<search>] [[--] ...<utility>]
			    Get the detauls in JSON of available packages for the search or utilities.

			These options provide hooks:

			--action-eval=<invocation>
			    Runs the <invocation> if the action will be invoked.
			--acted-eval=<invocation>
			    Runs the <invocation> if the action was invoked.
			--configure-eval=<invocation>
			    Runs the <invocation> after the action, if <configure> is true.

			These options specify and customise our interaction with the utility:

			--name=<name>
			    The name to use for the utility in human readable output, such as log messages.

			--[no-]optional
			    If enabled, do not return a failure code if the action was unable to be performed.
			--[no-]confirm
			    If enabled, confirm installation of the utility before installing it.
			--[no-]xdg
			    If disabled, place the binary in \`/usr/local/bin\` and symlink the XDG binary to it, such that it is exposed to root.
			--[no-]force
			    If enabled, use the <source>'s force mode if it has one.
			--[no-]elevate
			    Specify whether the utility requires elevation. Forwarded to \`command-working\`.

			--[no-]dependency
			    If enabled, note this utility is a dependency, which will:
			    * only output messages iff changes occur
			    * disable <configure> and <extra>
			    * not perform setup action if <dependencies> is disabled
			--[no-]deps | --[no-]dependencies
			    If disabled, do not install any dependencies, even if required.
			    ! If empty, defaults to the \`SETUP_UTIL__DEPENDENCIES\` environment variable; which this option will export.
			--[no-]extra
			    If disabled, do not install any recommended but supplementary dependencies.
			    ! If empty, defaults to the \`SETUP_UTIL__EXTRA\` environment variable; which this option will export.
			--[no-]fallback
			    If disabled, do not install a package system in order to install the package.
			    ! If empty, defaults to the \`SETUP_UTIL__FALLBACK\` environment variable; which this option will export.
			--[no-]slim
			    If enabled, disables <configure>, <fallback>, <dependencies>, <extras>.
			    ! If empty, defaults to the \`SETUP_UTIL__SLIM\` environment variable; which this option will export.
			--dependency=...<dependencies>
			    Append these <dependencies> to the list of dependencies that must be installed before this utility is installed.
			--dependencies=<dependencies>
			    Set these <dependencies> as the list of dependencies that must be installed before this utility is installed.
			--[no-]quiet | --[no-]verbose
			    If unspecified, outputs only useful things.
			    If quiet, don't output anything that isn't an error message.
			    If verbose, output everything.

			These options specify the operation of the action on an predefined utility:

			[--first-success] [--] ...<utility>
			    E.g. \`setup-util install bat\` and \`setup-util install -- bat\` will trigger \`setup-util-bat\`.
			    E.g. \`setup-util --first-success -- bat bottom\` will not install \`bottom\` if \`bat\` became installed.

			These options define a utility:

			--cli=...<cli>
			    Used to check if the utility is already installed, in this case, a CLI executable.
			--app=...<app>
			    Used to check if the utility is already installed, in this case, an application.
			--font=...<font>
			    Used to check if the utility is already installed, in this case, a font.
			--checker=<command>
			    The <command> is invoked to check if the utility is already installed. It should return [0] if installed, [1] if not installed.

			These options define how to setup the utility, they are referred to as sources:
			! \`=()\` indicates the option can be specified multiple times, e.g. [APT=one APT=two].
			! \`=''\` indicates the option can be specified only once.
			$source_options_rendered

			These options allow us to tranpose one source to many packages:

			--transpose=<source> -- ...<package>
			    Transposes <package>s onto a specific <source>.
			    e.g. \`setup-util upstall --transpose=APT -- a b c\` becomes
			         \`setup-util upstall APT=a APT=b APT=c\`

			These options customise/override the order of the sources:

			--source=<sources> | --sources=<sources> | --order=<sources>
			    Used to override the preferred order of each source, space separated. Use \`...\` as placeholder for those not yet explicitly specified.

			SOURCES:
			Available sources are, in their default order of preference:
			$sources_rendered
		EOF
		return 22 # EINVAL 22 Invalid argument
	}

	# <options-for-sources>
	local APPIMAGE=() APPIMAGE_FILENAME=''
	local APK=() APK_REPO=''
	local APT=() APT_REPO='' APT_KEY='' APT_ID=''
	local AUR=()
	local AURUTILS=()
	local BREW=() BREW_TAP=()
	local BSD=()
	local CABAL=()
	local CARGO=() RUST=()
	local CASK=() CASK_TAP=()
	local CONDA=() CONDA_CHANNEL=''
	local CUSTOM_EVAL=() CUSTOM_INSTALL_EVAL=() CUSTOM_UNINSTALL_EVAL=() CUSTOM_UPGRADE_EVAL=()
	local DNF=() DNF_GROUP=() DNF_COPR=() DNF_REPO=()
	local DOWNLOAD='' DOWNLOAD_FILENAME=() DOWNLOAD_TARGET_PATH=() DOWNLOAD_BEARER_TOKEN='' DOWNLOAD_ARCHIVE_EXTRACT='' DOWNLOAD_ARCHIVE_FORMAT='' DOWNLOAD_ARCHIVE_GLOB='' DOWNLOAD_BUILD_INSTALL_EVAL='' DOWNLOAD_BUILD_UNINSTALL_EVAL='' DOWNLOAD_BUILD_GLOB=''
	local DPKG=() DEB=()
	local EMERGE=() EMERGE_REPO=()
	local EOPKG=()
	local FLATPAK=() FLATPAK_REPO=()
	local GEM=() RUBY=()
	local GO=()
	local GUIX=()
	local INSTALLER='' INSTALLER_FILENAME='' INSTALLER_OPEN='' INSTALLER_UNINSTALL_ARGUMENT=()
	local MAS=()
	local NIX=() NIX_PROFILE=()
	local NPM=() NODE=()
	local NVM=()
	local PACMAN=()
	local PAKKU=()
	local PAMAC=()
	local PARU=()
	local PKG=()
	local PKGADD=()
	local PKGIN=()
	local PORT=()
	local RPM=()
	local SOAR=()
	local SCOOP=() SCOOP_BUCKET=()
	local SNAP=() SNAP_CHANNEL=''
	local URPMI=()
	local UV=() PYTHON=()
	local WINGET=()
	local XBPS=()
	local YAY=()
	local YUM=() YUM_REPO=()
	local ZYPPER=() ZYPPER_TYPE='' ZYPPER_REPO='' ZYPPER_REPO_ALIAS=''
	# </options-for-sources>

	# process
	# help is done as an option to avoid recursive actions, like `--check` to output double help
	local item \
		action_action='' option_special_action='' option_defined='no' \
		option_install='' option_upgrade='' option_reinstall='' option_uninstall='' option_configure='' \
		option_check='' option_is_installed='' option_is_uninstalled='' option_want_install='' option_want_upgrade='' option_want_reinstall='' option_want_uninstall='' option_search='' option_get_installed='' option_get_installer='' option_invoke='' option_help='' \
		option_action_eval='' option_acted_eval='' option_configure_eval='' \
		option_name='' \
		option_optional='' option_confirm='' option_xdg='' option_force='' option_elevate='' \
		option_is_dependency='' option_wants_dependencies='' option_dependencies=() option_extsra='' option_fallback='' option_slim='' option_quiet='' \
		option_first_success='' \
		option_utilities=() \
		option_clis=() option_apps=() option_fonts=() option_checker='' \
		option_transpose='' \
		option_order=()
	function __parse_special_action {
		local action="$1" value
		shift
		for value in "$@"; do
			if [[ $value == 'yes' ]]; then
				option_special_action="$action"
			fi
		done
	}
	while [[ $# -ne 0 ]]; do
		item="$1"
		shift
		case "$item" in
		# definitions, this is earlier due to naming conflict
		'--cli='*) __split --target={option_clis} --append --delimiters=$'\n\t ,|' --no-zero-length -- "${item#*=}" ;;
		'--clis='*) __split --target={option_clis} --delimiters=$'\n\t ,|' --no-zero-length -- "${item#*=}" ;;
		'--app='*) __split --target={option_apps} --append --delimiters=$'\n\t ,|' --no-zero-length -- "${item#*=}" ;;
		'--apps='*) __split --target={option_apps} --delimiters=$'\n\t ,|' --no-zero-length -- "${item#*=}" ;;
