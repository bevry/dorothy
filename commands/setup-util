	local -i STATUS__PACKAGE_STATE_NOT_APPLICABLE=205  # ECUSTOM 20x Not applicable as the package is not in an applicable state for the desired action (e.g. upgrading or invoking an uninstalled package)
	local -i STATUS__PACKAGE_STATE_ALREADY_DESIRED=206 # ECUSTOM 20x Not applicable as the package is already in the desired state for the action (e.g. uninstalling an already uninstalled package, installing an already installed package, updating or upstalling an already updated package)
	local -i STATUS__SOURCE_FALLBACK=207               # ECUSTOM 20x Not applicable yet as the package system is not yet installed, and has a fallback
	local -i STATUS__SOURCE_MISSING=208                # ECUSTOM 20x Not applicable yet as the package system is not yet installed, and does not have a fallback
	function __applicable {
		local item fallback='no' command="$SETUP_UTIL__SOURCE"
		while [[ $# -ne 0 ]]; do
			item="$1"
			shift
			case "$item" in
			'--fallback') fallback='yes' ;;
			'--command=') comamnd="${item#*=}" ;;
			*) __unrecognised_argument "$item" || return $? ;;
