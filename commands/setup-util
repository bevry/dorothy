	# winget / Windows Package Manager Client
	# @../docs/setup-util/winget.md
	function __parse_winget_list {
		local query="$1" winget_rows=() row header_columns=()
		# Winget returns carriage returns that erase, and for newlines.
		# Winget has a header separator of ^---+\s*$`
		# Winget columns can be one or more spaces separated, which requires parsing as a table
		# So fetch the rows:
		__split --source=STDIN --target={winget_rows} --no-zero-length || return $?
		# Convert the rows into columns, maintaining their trailing spaces, so we can use their values for column length
		# Columns: Name, Id, Version, Available, Source
		__split --target={header_columns} --no-zero-length --invoke -- \
			echo-regexp -g --regexp='( +)' --replace=$'$1\n' -- "${winget_rows[0]}" || return $?
		local winget_name winget_source
		local winget_id winget_version winget_available
		local -i column left_index right_index
		function __reset {
			column=0 left_index=0 right_index=${#header_columns[0]}
		}
		function __bump {
			column=$((column + 1))
			left_index=$right_index
			right_index=$((right_index + ${#header_columns[column]}))
		}
		for row in "${winget_rows[@]:2}"; do
			__reset
			# winget_name="${row:left_index:right_index}"
			# __replace --source+target={winget_name} --trailing-whitespace --optional || return $?
			__bump
			winget_id="${row:left_index:right_index}"
			__replace --source+target={winget_id} --trailing-whitespace --optional || return $?
			__bump
			winget_version="${row:left_index:right_index}"
			__replace --source+target={winget_version} --trailing-whitespace --optional || return $?
			__bump
			winget_available="${row:left_index:right_index}"
			__replace --source+target={winget_available} --trailing-whitespace --optional || return $?
			# __bump
			# winget_source="${row:left_index:right_index}"
			# __replace --source+target={winget_source} --trailing-whitespace --optional || return $?
			__print_lines "$winget_id $winget_version $winget_available" || return $?
		done
	}
	function __setup__winget {
		local packages=("${WINGET[@]}")

		# applicability
		__applicable || return $?

		# action
		case "$option_action" in
		# is-*  ...<package>
		# only supports one package at a time
		'is-installed-all')
			local package
			for package in "${packages[@]}"; do
				if ! winget.exe list --disable-interactivity --id="$package" &>/dev/null; then
					return 1
				fi
			done
			;;
		'is-installed-any')
			local package
			for package in "${packages[@]}"; do
				if winget.exe list --disable-interactivity --id="$package" &>/dev/null; then
					return 0
				fi
			done
			return 1
			;;
		'is-installed-none')
			local package
			for package in "${packages[@]}"; do
				if winget.exe list --disable-interactivity --id="$package" &>/dev/null; then
					return 1
				fi
			done
			;;
		# list-* [...<package>] [--search=...<search>] | list-missing ...<package>
		'list-installed')
			winget.exe list | __workaround_carriage_returns | __parse_winget_list
			;;
		'list-outdated')
			;;
		'list-updated')
			;;
		'list-available')
			;;
		# setup-* ...<package>
		'setup-uninstall')
			local package
			for package in "${packages[@]}"; do
				winget.exe uninstall --disable-interactivity --accept-source-agreements --purge --exact --id="$package" || return $?
			done
			;;
		'setup-install')
			local package
			for package in "${packages[@]}"; do
				winget.exe install --disable-interactivity --accept-package-agreements --accept-source-agreements --no-upgrade --exact --id="$package" || return $?
			done
			;;
		'setup-upstall')
			local package
			for package in "${packages[@]}"; do
				winget.exe install --disable-interactivity --accept-package-agreements --accept-source-agreements --exact --id="$package" || return $?
			done
			;;
		'setup-update')
			local package
			for package in "${packages[@]}"; do
				winget.exe upgrade --disable-interactivity --accept-package-agreements --accept-source-agreements --exact --id="$package" || return $?
			done
			;;
		'system-update')
			local package
			for package in "${packages[@]}"; do
				winget.exe uupgrade --disable-interactivity --accept-package-agreements --accept-source-agreements --all || return $?
			done
			;;
		*) return "$STATUS__INVALID_ACTION" ;;
		esac

		# args
		# supports multiple packages at a time
		# --accept-package-agreements: Accept all license agreements for packages
		# --accept-source-agreements: Accept all source agreements during source operations
		if [[ $option_action == 'uninstall' ]]; then
			# https://learn.microsoft.com/en-us/windows/package-manager/winget/uninstall
			args+=('winget.exe' 'uninstall')
		elif [[ $option_upgrade == 'yes' ]]; then
			# https://learn.microsoft.com/en-us/windows/package-manager/winget/upgrade
			args+=('winget.exe' 'upgrade' '--accept-package-agreements' '--accept-source-agreements')
		else
			# https://learn.microsoft.com/en-us/windows/package-manager/winget/install
			args+=('winget.exe' 'install' '--accept-package-agreements' '--accept-source-agreements')
			# upgrade already handled via the earlier `winget upgrade` action
			# if [[ $option_upgrade == 'no' ]]; then
			# 	# --no-upgrade: Skips upgrade if an installed version already exists.
			# 	args+=('--no-upgrade')
			# fi
		fi
		# all actions support these
		if [[ $option_quiet == 'yes' || -n $CI ]]; then
			# -h,--silent: Request silent installation
			# --disable-interactivity: Disable interactive prompts
			args+=('--disable-interactivity' '--silent')
		fi
		if [[ $option_force == 'yes' ]]; then
			# --force: Direct run the command and continue with non security related issues.
			args+=('--force')
		fi
		# run the action
		"${args[@]}" "${packages[@]}" || return $? # eval
	}

