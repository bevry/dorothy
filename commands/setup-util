	# Alpine

	# apk / Alpine Linux
	# https://wiki.alpinelinux.org/wiki/Package_management
	# https://pkgs.alpinelinux.org/packages
	# https://man.archlinux.org/man/apk.8
	# https://man.archlinux.org/man/apk-del.8.en
	# https://man.archlinux.org/man/apk-add.8.en
	# https://man.archlinux.org/man/apk-upgrade.8.en
	# https://man.archlinux.org/man/apk-info.8.en
	# https://man.archlinux.org/man/apk-query.8.en
	# `apk` is strange, the documentation provides more options that are implemented in practice
	# `man apk info` describes query options, and supports then only when provided a search argument
	# `man apk list` describes query options. but does not actually support them <https://gitlab.alpinelinux.org/alpine/apk-tools/-/work_items/11207>
	# `apk query` naturally supports query options, and as such, requires a search argument
	# `apk info -e ...<search>` checks for installed packaged and returns exit status `1` if any are not installed,
	#  whereas `apk list|query --installed <search>` will list installed packages, ignore missing packages, and return exit status `0`
	# `--fields name,version` only works with `--format <json|yaml>` and becomes incompatible with `-e`, as they are query options
	# `apk list|info|query` all have an undocumented `--search` option that enables fuzzy searches <https://gitlab.alpinelinux.org/alpine/apk-tools/-/work_items/11210>
	# `apk query --format json ...<search>` returns: name, version, description, arch, license, origin, url, file-size
	# `apk info --format json ...<package>` returns: name, version, description, url, installed-size
	# there is also `--fields all` which returns more
	function __parse_apk_list {
		# sed coercion from <https://superuser.com/a/1870448/32418>
		# turns
		# ```
		# zziplib-doc-0.13.80-r1 x86_64 {zziplib} (LGPL-2.0-or-later OR MPL-1.1)
		# zziplib-utils-0.13.80-r1 x86_64 {zziplib} (LGPL-2.0-or-later OR MPL-1.1)
		# ```
		# into
		# ```
		# zziplib-doc 0.13.80-r1
		# zziplib-utils 0.13.80-r1
		# ```
		sed 's/ .*//;s/-\(r[0-9]\+\)$/@@\1/;s/\(.*\)-/\1 /;s/@@/-/' || return $?
	}
	function __parse_apk_yaml_query {
		# turns:
		# ```
		# - name: zziplib-doc
		# version: 0.13.80-r1
		# - name: zziplib-utils
		# version: 0.13.80-r1
		# ```
		# into:
		# ```
		# zziplib-doc 0.13.80-r1
		# zziplib-utils 0.13.80-r1
		# ```
		echo-regexp -gmo '- name:\s+([^\s]+)\s+version: ([^\s]+)' --replace='$1 $2'
	}
	function __setup__apk {
		local packages=("${APK[@]}") repo="$APK_REPO"

		# applicability
		__applicable || return $?

		# action
		case "$option_action"; in
		# is-*  ...<package>
		'is-installed-all') apk info -e "${packages[@]}" &>/dev/null || return 1 ;;
		'is-installed-any') __is_installed_all_to_any "${packages[@]}" || return $? ;;
		'is-installed-none') __is_installed_all_to_none "${packages[@]}" || return $? ;;
		# list-*
		'list-installed') apk list --installed | __parse_apk_list || return $? ;;
		'list-outdated') apk --update-cache list --upgradable | __parse_apk_list || return $? ;;
		'list-updated')
			# get all upgraded, and use their names to evict, then get all installed, and filter them by upgraded
			local outdated_ids=() other_id lines=() id version
			while read id version; do
				outdated_ids+=("$id")
			done < <(apk --update-cache list --upgradable | __parse_apk_list)
			# if none to evict, then exit early with all installed
			if [[ ${#outdated_ids[@]} -eq 0 ]]; then
				apk list --installed | __parse_apk_list || return $?
				return 0
			fi
			# if we have ones to evict, then do so
			while read id version; do
				for other_id in "${outdated_ids[@]}"; do
					if [[ $id == "$other_id" ]]; then
						continue
					fi
				done
				lines+=("$id $version")
				# printf '%s=%q %s=%q\n' id "$id" version "$version" || return $?
			done < <(apk list --installed | __parse_apk_list)
			__print_lines "${lines[@]}" || return $?
			;;
		'list-available') apk --update-cache list --available | __parse_apk_list || return $? ;;
		# search-* ...<package> --search=...<search>
		'search-'*)
			# glob
			local search_options=(--format=yaml --fields=name,version "${packages[@]}") search
			for search in "${option_search[@]}"; do
				search_options+=("*$search*")
			done
			;;&
		'search-installed' ) apk query --installed "${search_options[@]}" | __parse_apk_yaml_query || return $? ;;
		'search-outdated') apk --update-cache query --upgradable "${search_options[@]}" | __parse_apk_yaml_query || return $? ;;
		'search-updated')
			# get all upgraded, and use their names to evict, then get all installed, and filter them by upgraded
			local outdated_ids=() other_id lines=() id version
			while read id version; do
				outdated_ids+=("$id")
			done < <(apk --update-cache query --upgradable "${search_options[@]}" | __parse_apk_yaml_query)
			# if none to evict, then exit early with all installed
			if [[ ${#outdated_ids[@]} -eq 0 ]]; then
				apk query --installed "${search_options[@]}" | __parse_apk_yaml_query || return $?
				return 0
			fi
			# if we have ones to evict, then do so
			while read id version; do
				for other_id in "${outdated_ids[@]}"; do
					if [[ $id == "$other_id" ]]; then
						continue
					fi
				done
				lines+=("$id $version")
				# printf '%s=%q %s=%q\n' id "$id" version "$version" || return $?
			done < <(apk query --installed "${search_options[@]}" | __parse_apk_yaml_query)
			__print_lines "${lines[@]}" || return $?
			;;
		'search-available') apk --update-cache query --available "${search_options[@]}" | __parse_apk_yaml_query || return $? ;;
		# setup-* ...<package>
		'setup-'*)
			local repository_options=()
			if [[ -n $repo ]]; then
				repository_options+=(--repository "$repo")
			fi
			;;&
		'setup-uninstall') __elevate -- apk del "${packages[@]}" ;;
		'setup-install') __elevate -- apk --update-cache "${repository_options[@]}" add "${packages[@]}" ;;
		'setup-upstall') __elevate -- apk --update-cache "${repository_options[@]}" add --upgrade "${packages[@]}" ;;
		'setup-upgrade') __elevate -- apk --update-cache "${repository_options[@]}" upgrade "${packages[@]}" ;;
		'setup-upgrade-all') __elevate -- apk --update-cache upgrade ;;
		*) return "$STATUS__INVALID_ACTION" ;;
		esac
	}

