# When this is ready, place this in `setup.bash`:
# Used by `setup-util-fnm`
# FNM_NODE_VERSIONS_INSTALL=()

function setup_util_fnm() (
	source "$DOROTHY/sources/util.bash"
	# don't do the custom fnm installer as it can duplicate shell entries apparently
	util_options=(
		--name='Fast Node Manager (fnm)'
		--checker='node-env -- fnm --version'
		#--configure-eval='fnm_configure'
		BREW='fnm'
		WINGET='Schniz.fnm'
		SCOOP='fnm'
		CARGO='fnm'
	)
	# function fnm_configure {
	# 	if [[ $SETUP_UTIL__INSTALLED == 'yes' && $SETUP_UTIL__EXTRA == 'yes'  ]]; then
	# 		source "$DOROTHY/sources/config.sh"

	# 		# setup.bash provides:
	# 		local FNM_NODE_VERSIONS=()
	# 		load_dorothy_config 'setup.bash'

	# 		# Additional Node.js versions
	# 		if [[ ${#FNM_NODE_VERSIONS[@]} -ne 0 ]]; then
	# 			setup-util --transpose=FNM -- "${FNM_NODE_VERSIONS[@]}" || return $?
	# 		fi
	# 	fi
	# }

	# skip costly operations and fetches on shallow actions
	if setup-util is-shallow "${util_options[@]}" "${setup_options[@]}"; then
		setup-util shallow "${util_options[@]}" "${setup_options[@]}" || return $?
		return $?
	fi

	# fetch and use configuration
	local slug='Schniz/fnm' glob='*/fnm' arch
	arch="$(__get_arch)"
	if __is_macos; then
		__fetch_and_add_download_option_via_slug_suffix_glob "$slug" 'm-macos.zip' "$glob" || :
	elif __is_linux; then
		if [[ $arch == 'a64' ]]; then
			__fetch_and_add_download_option_via_slug_suffix_glob "$slug" '-arm64.zip' "$glob" || :
		elif [[ $arch == 'a32' ]]; then
			__fetch_and_add_download_option_via_slug_suffix_glob "$slug" '-arm32.zip' "$glob" || :
		elif [[ $arch == 'x64' ]]; then
			__fetch_and_add_download_option_via_slug_suffix_glob "$slug" '-linux.zip' "$glob" || :
		fi
	fi

	# setup
	setup-util "${util_options[@]}" "${setup_options[@]}"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_util_fnm "$@"
fi
