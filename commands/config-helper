# rust regular expressions, however we use ecmascript regular expressions
# https://docs.rs/regex/latest/regex/
# (?flags:exp)   set flags for exp (non-capturing)
# m     multi-line mode: ^ and $ match begin/end of line
# u     Unicode support (enabled by default)
# x     ignore whitespace and allow line comments (starting with `#`)
# ^ x doesn't seem to work
# the (?m) prefix turns out not be necessary, for sed, nor ripgrep

function config_helper_test() (
	source "$DOROTHY/sources/bash.bash"
	eval-tester --ignore-stderr --status=22 -- config-helper --help

	local delay=1
	if [[ -n $CI ]]; then
		delay=3
	fi

	# prepare
	local root test_file missing_file expected_stderr
	root="$(fs-temp --directory='dorothy' --directory='config-helper')"
	fs-remove --quiet --no-confirm -- "$root"
	test_file="$(
		fs-temp \
			--root="$root" \
			--directory='tests' \
			--file --touch
	)"
	missing_file="$(
		fs-temp \
			--root="$root" \
			--directory='tests' \
			--file --no-touch
	)"

	# test invalid arguments fail
	sleep "$delay"
	eval-tester --name='test-invalid-arguments-01' --status=22 --ignore-stderr -- \
		config-helper --no-color
	sleep "$delay"
	eval-tester --name='test-invalid-arguments-02' --status=22 --ignore-stderr -- \
		config-helper --no-color --no-quiet --file="$missing_file"
	sleep "$delay"
	eval-tester --name='test-invalid-arguments-03' --status=22 --ignore-stderr -- \
		config-helper --no-color "$missing_file"

	# test invalid find and replace arguments
	sleep "$delay"
	eval-tester --name='test-invalid-find-and-replace-arguments-01' --status=22 --ignore-stderr -- \
		config-helper --no-color --no-quiet --file="$test_file" -- --replace='one'
	# ^ fails completely
	sleep "$delay"
	eval-tester --name='test-invalid-find-and-replace-arguments-02' --status=22 --ignore-stderr -- \
		config-helper --no-color --no-quiet --file="$test_file" -- --find='a' --replace='one' --replace='two'
	# ^ first find and replace succeeds on the empty test_file, hence `one`, second find and replace failed, hence no two
	sleep "$delay"
	eval-tester --name='test-invalid-find-and-replace-arguments-03' --stdout=$'one\n' -- \
		cat -- "$test_file"

	# test creating a non-existent file
	expected_stderr="Updated configuration file: $missing_file"
	sleep "$delay"
	eval-tester --name='test-missing-file-01' --stderr="$expected_stderr"$'\n' -- \
		config-helper --no-color --no-quiet --file="$missing_file" -- \
		--find='commands.local[/]' --replace='commands.local/' \
		--find='config.local[/]' --replace='config.local/'
	sleep "$delay"
	eval-tester --name='test-missing-file-02' --stdout=$'commands.local/\nconfig.local/\n' -- \
		cat -- "$missing_file"

	# test an empty file
	expected_stderr="Updated configuration file: $test_file"
	sleep "$delay"
	eval-tester --name='test-empty-file-01' --stderr="$expected_stderr"$'\n' -- \
		config-helper --no-color --no-quiet --file="$test_file" -- \
		--find='commands.local[/]' --replace='commands.local/' \
		--find='config.local[/]' --replace='config.local/'
	sleep "$delay"
	eval-tester --name='test-empty-file-02' --stdout=$'one\ncommands.local/\nconfig.local/\n' -- \
		cat -- "$test_file"

	# test existing file
	sleep "$delay"
	eval-tester --name='test-existing-file-01' --stderr="$expected_stderr"$'\n' -- \
		config-helper --no-color --no-quiet --file="$test_file" -- \
		--find='commands.local[/]' --replace='commands.replaced/' \
		--find='config.local[/]' --replace='config.replaced/'
	sleep "$delay"
	eval-tester --name='test-existing-file-02' --stdout=$'one\ncommands.replaced/\nconfig.replaced/\n' -- \
		cat -- "$test_file"

	# redo test file
	sleep "$delay"
	__print_lines $'User=uu\n\tGroup=gg\n\t# Party=pp' >"$test_file"

	# test find only, used by <sharebox> command
	sleep "$delay"
	eval-tester --name='test-find-only' --stdout=$'User=uu\nuu\nGroup=gg\ngg\n' -- \
		config-helper --no-color --no-quiet --file="$test_file" -- \
		--find='User=(.*)' \
		--field='User' \
		--find='Group=(.*)' \
		--field='Group' \
		--find='Party=(.*)' \
		--field='Party'

	# uncomment party
	sleep "$delay"
	eval-tester --name='test-uncomment-and-return' --stdout=$'sup\n' --stderr="$expected_stderr"$'\n' -- \
		config-helper --no-color --no-quiet --file="$test_file" -- \
		--find='Party=(.*)' --replace='Party=sup' \
		--field='Party'

	# test variable replacements and additions
	# this is the command it fails on
	sleep "$delay"
	__print_lines $'a=one\n\tb=(two three)\n\ta=three\n\tb=(four five)' >"$test_file"
	sleep "$delay"
	eval-tester --name='test-variable-replacement-and-addition-01' --stderr="$expected_stderr"$'\n' -- \
		config-helper --no-color --no-quiet --file="$test_file" -- \
		--field='a' --no-quote --value='1' \
		--field='b' --array="$(__print_lines 2 3)" \
		--field='aa' --value='value addition' \
		--field='bb' --array="$(__print_lines 22 33)"
	sleep "$delay"
	eval-tester --name='test-variable-replacement-and-addition-02' --stdout=$'a=1\n\tb=(\n\t\t\'2\'\n\t\t\'3\'\n\t)\naa=\'value addition\'\nbb=(\n\t\'22\'\n\t\'33\'\n)\n' -- cat -- "$test_file"

	# test complicated values
	sleep "$delay"
	__print_lines $'a=one\n\tb=(two three)\n\ta=three\n\tb=(four five)' >"$test_file"
	sleep "$delay"
	eval-tester --name='test-complicated-values-01' --stderr="$expected_stderr"$'\n' -- \
		config-helper --no-color --no-quiet --file="$test_file" -- \
		--field='a' --value='double "quote" inside' \
		--field='b' --columns=2 --array="$(__print_lines 'double "quote" inside' "single 'quote' inside" 3 4)" \
		--field='aa' --value="single 'quote' inside" \
		--field='bb' --columns=2 --array="$(__print_lines 'more double "quote" inside' "more single 'quote' inside" 33 44)"
	sleep "$delay"
	eval-tester --name='test-complicated-values-02' --stdout=$'a=\'double "quote" inside\'\n\tb=(\n\t\t\'double "quote" inside\'  "single \'quote\' inside"\n\t\t\'3\'                      \'4\'\n\t)\naa="single \'quote\' inside"\nbb=(\n\t\'more double "quote" inside\'  "more single \'quote\' inside"\n\t\'33\'                          \'44\'\n)\n' -- \
		cat -- "$test_file"

	# test values with dollar signs and backslashes
	sleep "$delay"
	__print_lines '$env.VALUE="hello\world"' 'second line' >"$test_file"
	sleep "$delay"
	eval-tester --name='test-dollar-signs-01' --stderr="$expected_stderr"$'\n' -- \
		config-helper --no-color --no-quiet --file="$test_file" -- \
		--line-with-substring='$env.VALUE' --string-replace='$env.VALUE="HELLO\WORLD"'
	sleep "$delay"
	eval-tester --name='test-dollar-signs-02' --stdout='$env.VALUE="HELLO\WORLD"'$'\n' -- \
		cat -- "$test_file"

	# done
)
function config_helper() (
	source "$DOROTHY/sources/bash.bash"

	# =====================================
	# Arguments

	function help {
		__print_help "$@" <<-EOF || return $?
			USAGE:
			\`config-helper [...options] <file> -- [...operations]\`

			OPTIONS:
			<file> | --file=<file> | --path=<file>
			    A configuration file that you would like to update, such as:
			    * \`/etc/systemd/resolved.conf\`
			    * \`interactive.sh\`
			    * \`.gitignore\`

			--elevated=<elevated>
			--elevate=<elevate>
			--user=<user>
			--group=<group>
			--reason=<reason>
			    Forwarded to \`eval-helper\`.

			OPERATIONS:
			--find=<pattern>
			    Outputs the found result.
			--find=<pattern> --replace=<pattern>
			    Replaces the pattern with the pattern.
			--field=<field>
			    Outputs the value of the field.
			--field=<field> --value=<value>
			    Sets the field to the value.
			--field=<field> --array=<lines>
			    Sets the field to an array of the lines.

			QUIRKS:
			If a commented \`--find=<pattern>\` or \`--field=<field>\` is found, the replacement will be placed there.
			If multiple results are found, the replacement will only leave the replacement.
			If <pattern> is empty, it will replace all empty lines with the replacement.
			If not found, an addition will occur.
		EOF
		return 22 # EINVAL 22 Invalid argument
	}

	# process
	local item option_args=() option_quiet='' option_file='' option_multiple='ok' option_elevated='' option_elevate='' option_user='' option_group='' option_reason=''
	while [[ $# -ne 0 ]]; do
		item="$1"
		shift
		case "$item" in
		'--help' | '-h') help ;;
		'--no-color'* | '--color'*) __flag --source={item} --target={COLOR} --affirmative --export ;;
		'--file='* | '--path='*) option_file="${item#*=}" ;;
		'--no-verbose'* | '--verbose'*) __flag --source={item} --target={option_quiet} --non-affirmative ;;
		'--no-quiet'* | '--quiet'*) __flag --source={item} --target={option_quiet} --affirmative ;;
		'--multiple=ok' | '--multiple=warn-skip' | '--multiple=warn-apply') option_multiple="${item#*=}" ;;
		# <elevate>
		'--elevated='*) option_elevated="${item#*=}" ;;
		'--no-elevate'* | '--elevate'*) __flag --source={item} --target={option_elevate} --affirmative --no-coerce ;;
		'--user='*) option_user="${item#*=}" ;;
		'--group='*) option_group="${item#*=}" ;;
		'--reason='*) option_reason="${item#*=}" ;;
		# </elevate>
		'--')
			option_args+=("$@")
			shift $#
			break
			;;
		'--'*) help 'An unrecognised flag was provided: ' --variable-value={item} ;;
		*)
			if [[ -z $option_file ]]; then
				option_file="$item"
			else
				help 'An unrecognised argument was provided: ' --variable-value={item}
			fi
			;;
		esac
	done

	# check
	if [[ ${#option_args[@]} -eq 0 ]]; then
		help 'Need arguments, otherwise what is the point?'
	fi

	# ensure file
	if [[ -z $option_file ]]; then
		help --help='Need a <file> to work with.'
	fi

	# ensure file exists
	if [[ ! -f $option_file ]]; then
		printf '' | echo-write --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$option_file"
	fi

	# =====================================
	# Action

	local UPDATED='no'
	function iterate {
		local -i count
		local option_search option_columns='1' option_quote='yes' option_replace \
			content \
			search_value entry_regexp variable_literal variable_regexp get_regexp \
			replace_value replace_regexp replace_lines replace_literal addition remove_regexp
		while [[ $# -ne 0 ]]; do
			# extract arguments
			option_search="$1"
			shift

			# extract special cases
			case "${1-}" in
			'--columns='*)
				option_columns="${1#*=}"
				shift
				;;
			'--quote=bash')
				option_quote='bash'
				shift
				;;
			'--quote=command')
				option_quote='command'
				shift
				;;
			'--quote=generic')
				option_quote='generic'
				shift
				;;
			'--no-quote'* | '--quote'*)
				# ^ matches quote= and quoted=
				__flag --target={option_quote} --affirmative -- "$1"
				shift
				;;
			'' | '--search-'* | '--field='* | '--remove' | '--replace-'* | '--array='* | '--value='*) : ;;
			*) help 'Invalid argument ' --variable-value="${1-}" ' encountered.' ;;
			esac

			# adjust quote based on file
			if [[ $option_quote =~ ^(generic|yes)$ ]]; then
				if [[ $option_file == *'.bash' || $option_file == *'.sh' ]]; then
					option_quote='bash'
				else
					option_quote='generic'
				fi
			fi

			# extract next argument, shift is handled later, as could ba another find
			option_replace="${1-}"

			# reset variables
			content=''
			search_value=''
			entry_regexp=''
			variable_literal=''
			variable_regexp=''
			get_regexp=''
			replace_value=''
			replace_regexp=''
			replace_lines=()
			replace_literal=''
			addition=''
			remove_regexp=''

			# `echo-regexp` uses ecmascript regular expressions

			# search/get
			case "$option_search" in
			'--search-for-substring-entry='* | '--search-for-literal-entry='* | '--search-for-regexp-entry='* | '--find='*)
				# indentable, commentable, regexp
				search_value="${option_search#*=}"
				case "$option_search" in
				'--search-for-regexp-entry='* | '--find='*) entry_regexp="$search_value" ;;
				'--search-for-substring-entry='*) entry_regexp=".*?$(echo-escape-regexp -- "$search_value").*" ;;
				*) entry_regexp="$(echo-escape-regexp -- "$search_value")" ;;
				esac
				search_regexp="^(?<indent>[[:blank:]]*)(?<comment>(?:#|[[:blank:]])*)(?<value>$entry_regexp)(?<trail>\n|$)"
				get_regexp="^(?<indent>[[:blank:]]*)(?<value>$entry_regexp)(?<trail>\n|$)" # ignore comments
				#remove_regexp='${indent}'
				;;
			'--search-for-literal-variable='* | '--field='*)
				# field that can be an array and value
				search_value="${option_search#*=}"
				variable_literal="$search_value"
				variable_regexp="$(echo-escape-regexp -- "$search_value")"
				# cannot support `--search-for-regexp-variable` as additions require pre-knowing the literal variable name
				search_regexp="^(?<indent>[[:blank:]]*)(?<comment>(?:#|[[:blank:]])*)(?<variable>$variable_regexp) *= *(?<value>[(][\s\S]*?[)]|[^\n]*)(?<trail>\n|$)"
				get_regexp="^(?<indent>[[:blank:]]*)(?<variable>$variable_regexp) *= *(?<value>[(][\s\S]*?[)]|[^\n]*)(?<trail>\n|$)" # ignore comments
				#remove_regexp='${indent}'
				# use [\s\S] instead of (?s:.) as [\s\S] supports old Deno versions
				;;
			*) help 'Invalid search argument ' --variable-value={option_search} ' encountered.' ;;
			esac

			# addition/replace
			case "$option_replace" in
			'--remove' | '--replace-with-nothing' | '--replace-entry-with-literal-line=')
				replace_value=''
				replace_regexp=''
				addition=''
				;;
			'--replace-entry-with-literal-line='*)
				# raw replace line
				replace_value="${option_replace#*=}"
				replace_regexp="\${indent}$(echo-escape-regexp-replacement -- "$replace_value")\${trail}"
				addition="$replace_value"$'\n'
				;;
			'--replace-value-of-variable-with-array='* | '--array='*)
				replace_value="${option_replace#*=}"
				if [[ -z $variable_literal ]]; then
					help 'The provided option ' --code='--replace-value-of-variable-with-array=<' --variable-value={replace_value} --code='>' ' must be paired with ' --code='--search-for-literal-variable=<variable>'
				fi

				# adapt for array
				__split --source={replace_value} --target={replace_lines} --keep-zero-length # read lines into an array, such that indentation works

				# addition, use spaces for consistency with replacements, also use spaces as editors show tabs at variable widths
				replace_literal=$'(\n'"$(echo-lines --indent=$'\t' --quote="$option_quote" --columns="${option_columns:-"1"}" --width=inputs --filler=space -- "${replace_lines[@]}")"$'\n)'
				addition="$variable_literal=$replace_literal"$'\n'

				# replacement, use spaces as the filler, as without echo-lines being aware of the content of ${indent}, there is no way for it to correctly align tabs, also use spaces as editors show tabs at variable widths
				replace_literal=$'(\n'"$(echo-lines --indent=$'${indent}\t' --quote="$option_quote" --columns="${option_columns:-"1"}" --width=inputs --filler=space -- "${replace_lines[@]}")"$'\n${indent})'
				replace_regexp="\${indent}\${variable}=$replace_literal\${trail}"

				# reset columns
				option_columns='1'
				;;
			'--replace-value-of-variable-with-value='* | '--value='*)
				replace_value="${option_replace#*=}"
				if [[ -z $variable_literal ]]; then
					help 'The provided option ' --code='--replace-value-of-variable-with-value=<' --variable-value={replace_value} --code='>' ' must be paired with ' --code='--search-for-literal-variable=<variable>'
				fi

				# addition and replacement
				if [[ $option_quote == 'bash' ]]; then
					replace_value="$(echo-escape-bash -- "$replace_value")"
				elif [[ $option_quote == 'command' ]]; then
					replace_value="$(echo-escape-command -- "$replace_value")"
				elif [[ $option_quote =~ ^(generic|yes)$ ]]; then
					replace_value="$(echo-quote -- "$replace_value")"
				fi
				addition="$variable_literal=$replace_value"$'\n'
				replace_regexp="\${indent}\${variable}=$replace_value\${trail}"
				option_quote='yes' # reset it for next time
				;;
			'--replace'*) help 'Invalid replace argument ' --variable-value={option_replace} ' encountered.' ;;
			*)
				# this replacement option was not a replacement option
				# so we are not a replacement, but a get/has operation
				# in which case, get the value
				echo-file --raw --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$option_file" |
					echo-regexp -omn --find="$get_regexp" --replace='${value}' || :
				# do not shift (retain this replacement for future parsing)
				# and continue to the future parsing
				continue
				;;
			esac

			# the replacement option was indeed a replacement option
			# so shift it, and proceed to do the replacement
			shift

			# ensure if there is a value, it only has a single trailing line, and if there isn't a value, it is empty
			content="$(echo-file --raw --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$option_file")"
			__replace --source+target={content} --optional --trailing-newlines
			if [[ -n $content ]]; then
				content+=$'\n'
			fi

			# do the replacement or addition
			count="$(__print_value_strings_or_nothing "$content" | echo-regexp -cm --find="$search_regexp" || :)"
			if [[ -z $count || $count -eq 0 ]]; then
				# it wasn't found, so add manually if it's not empty
				if [[ -n $addition ]]; then
					__print_value_strings_or_nothing "$content" "$addition" |
						echo-write --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$option_file"
					UPDATED='yes' # a valid update occurred, note for logging
				fi
			elif [[ $count -eq 1 || $option_multiple == 'ok' ]]; then
				# first match replaced, subsequent matches removed
				__print_value_strings_or_nothing "$content" |
					echo-regexp -gm --find="$search_regexp" --replace="$replace_regexp" --replace="$remove_regexp" |
					echo-write --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$option_file"
				UPDATED='yes' # a valid update occurred, note for logging
			else
				local temp_file
				temp_file="$(
					fs-temp \
						--directory='config-helper' \
						--directory="$(basename -- "$option_file")" \
						--file --no-touch
				)"
				if [[ $option_multiple == 'warn-skip' ]]; then
					# write update to temp file (for diff), do not update intended file
					__print_value_strings_or_nothing "$content" |
						echo-regexp -gm --find="$search_regexp" --replace="$replace_regexp" --replace="$remove_regexp" |
						echo-write --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$temp_file"
					__print_style --stderr \
						--notice1='The configuration file ' --code-error1="$option_file" --error1=' was not saved' --notice1=' as multiple value instances exist within the configuration file, which may be computational conditions that our automation would be fraught to update.' --newline \
						--info1='When you can' --notice1=' manually apply the requested changes to your configuration such that this automated update will not be attempted again.' --newline \
						--notice1='Below is our unapplied automated attempt, saved to ' --code-notice1="$temp_file" --newline \
						--="$(
							fs-diff --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$option_file" "$temp_file" || :
						)" --newline \
						--notice1=$'\n'
				elif [[ $option_multiple == 'warn-apply' ]]; then
					# write backup to temp file, write update to intended file
					__print_value_strings_or_nothing "$content" >"$temp_file"
					echo-regexp -gm --find="$search_regexp" --replace="$replace_regexp" --replace="$remove_regexp" <"$temp_file" |
						echo-write --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$option_file"
					UPDATED='yes' # a valid update occurred, note for logging
					__print_style --stderr \
						--notice1='The configuration file ' --code-notice1="$option_file" --notice1=' ' --good1='was updated successfully.' --newline \
						--info1='However,' --notice1=' only a single replacement is supported but multiple were performed. The changes that were made are a best effort upon evaluated values and may be incorrect if conditional values were used.' --newline \
						--info1='Review the changes for correctness.' --notice1=' A backup has been made to ' --code-notice1="$temp_file" --newline \
						--="$(
							fs-diff --elevated="$option_elevated" --elevate="$option_elevate" --user="$option_user" --group="$option_group" --reason="$option_reason" -- "$temp_file" "$option_file" || :
						)" --newline \
						--notice1=$'\n'
				fi
			fi
		done
	}

	# cycle through options
	iterate "${option_args[@]}"

	# we do our own processing, as we need to support multiline matches
	if [[ $UPDATED == 'yes' && $option_quiet != 'yes' ]]; then
		__print_style --stderr --success='Updated configuration file:' ' ' --path="$option_file"
	fi
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	if [[ $* == '--test' ]]; then
		config_helper_test
	else
		config_helper "$@"
	fi
fi
