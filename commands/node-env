#!/usr/bin/env bash

function node_env_test() (
	source "$DOROTHY/sources/bash.bash"
	eval-tester --ignore-stderr --status=22 -- node-env --help
)

function node_env() (
	source "$DOROTHY/sources/bash.bash"

	# =====================================
	# Arguments

	local all_tools=(node fnm nvm)

	function __help {
		__print_help "$@" <<-EOF || return $?
			ABOUT:
			Execute a command that depends on Node.js being installed.
			Supports $(__join --source={all_tools} --style='code' --between=', ') Node.js environments. \`node\` is the system Node.js installation.

			USAGE:
			\`node-env [...options] [--] <...command>\`

			OPTIONS:
			--node | --nvm | --fnm | --tool=<tool:$(__join --source={all_tools} --between='|' -- '?')>
			    The tool to use for the Node.js environment.
				Use \`?\` to prompt.
				~ Default is the first available tool in that order.
			--[no-]install
			    Install the <tool> if necessary.
			    ! Defaults to disabled.

			--[no-]rosetta=[yes|no]
			    If empty, and if <tool=nvm>, then auto-detection is used to determine if Rosetta should be used to install Node.js versions that do not support ARM:
			    <https://github.com/nvm-sh/nvm/issues/2596>

			RETURNS:
			[3] if Node.js was not found.
		EOF
		return 22 # EINVAL 22 Invalid argument
	}

	# process
	local item option_tool='' option_install='no' option_rosetta='' option_cmd=()
	while [[ $# -ne 0 ]]; do
		item="$1"
		shift
		case "$item" in
		'--help' | '-h') __help || return $? ;;
		'--node' | '--fnm' | '--nvm') option_tool="${item:2}" ;;
		'--tool='*) option_tool="${item#*=}" ;;
		'--no-install'* | '--install'*) __flag --source={item} --target={option_install} --affirmative --coerce ;;
		'--no-rosetta'* | '--rosetta'*) __flag --source={item} --target={option_rosetta} --affirmative ;;
		'--')
			option_cmd+=("$@")
			shift $#
			break
			;;
		*)
			option_cmd+=("$item" "$@")
			shift $#
			break
			;;
		esac
	done

	# ensure
	if [[ ${#option_cmd[@]} -eq 0 ]]; then
		__help --help='No <...command> was provided.'
	fi

	# ensure tool
	__tool --tool={option_tool} --tools={all_tools} --help={__help} --install="$option_install" || return $?
	source "$DOROTHY/sources/environment.sh"

	# =====================================
	# Execute

	# npm global path is customisable, typically to the home directory, to avoid permission issues
	local path_exec='export PATH="$(npm config get prefix || :)/bin:$PATH"'

	# if nvm
	if [[ $option_tool == 'node' ]]; then
		# just run the command
		eval "$path_exec" || return $? # eval
		"${option_cmd[@]}" || return $? # eval
	elif [[ $option_tool == 'fnm' ]]; then
		if [[ -z ${FNM_PATH-}  ]]; then
			export FNM_PATH="$XDG_DATA_HOME/fnm"
		fi

		# fnm can inject this fnm call into the shell config, so we can check if loading its environment is necessary
		# `FNM_ARCH` is one of the exports that `fnm env` sets
		if [[ -z ${FNM_ARCH-} ]]; then
			eval "$(fnm env --shell bash)" || :
		fi

		# run the command through fnm
		eval "$path_exec" || return $? # eval
		fnm "${option_cmd[@]}" || return $? # eval
	elif [[ $option_tool == 'nvm' ]]; then
		# prepare
		if [[ -z ${NVM_DIR-}  ]]; then
			export NVM_DIR="$HOME/.nvm"
		fi

		# the nullglob is to fix: https://github.com/nvm-sh/nvm/issues/3727
		local nvm_exec='shopt -s nullglob; source "$NVM_DIR/nvm.sh"'

		# convert to quoted string if not already quoted
		local cmd_exec
		if [[ ${#option_cmd[@]} -eq 1 ]]; then
			cmd_exec="${option_cmd[0]}"
		else
			cmd_exec="$(echo-escape-command -- "${option_cmd[@]}")" || return $?
		fi
		# rosetta
		if ! is-system --apple-silicon; then
			option_rosetta='no'
		elif [[ -z $option_rosetta ]]; then
			local bin="${option_cmd[0]}" action="${option_cmd[1]-}" version="${option_cmd[2]-}"
			# only apply to `nvm install <version below 16>`
			if [[ $bin == 'nvm' && $action == 'install' ]] && __is_number "$version" && [[ "$(version-compare "$version" 16)" == -1 ]]; then
				option_rosetta='yes'
			else
				option_rosetta='no'
			fi
		fi

		# execute the command in new bash environment that doesn't inherit our strict mode
		if [[ $option_rosetta == 'yes' ]]; then
			# only /bin/bash allows rosetta
			arch -x86_64 /bin/bash -c "$nvm_exec; $path_exec; $cmd_exec" || return $? # eval
		else
			bash -c "$nvm_exec; $path_exec; $cmd_exec" || return $? # eval
		fi
	else
		return 14 # EFAULT 14 Bad address
	fi
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	if [[ $* == '--test' ]]; then
		node_env_test
	else
		node_env "$@"
	fi
fi
