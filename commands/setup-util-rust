#!/usr/bin/env bash

function setup_util_rust() (
	source "$DOROTHY/sources/bash.bash"
	util_options=(
		--cli='rustup'
		--configure-eval='rust_configure'
		--dependency=devel
		CUSTOM_INSTALL_EVAL='__rust_install'
		CUSTOM_UPGRADE_EVAL='__rust_upgrade'
		CUSTOM_UNINSTALL_EVAL='__rust_uninstall'
	)
	function rust_configure {
		if [[ $SETUP_UTIL__INSTALLED == 'yes' && $SETUP_UTIL__EXTRA == 'yes' ]]; then
			source "$DOROTHY/sources/config.sh"

			# setup.bash provides:
			local CARGO_INSTALL=()
			load_dorothy_config 'setup.bash'

			# adjustments
			__split --target={CARGO_INSTALL} --no-zero-length --invoke -- \
				dorothy-config --packages-var='CARGO_INSTALL' -- "${CARGO_INSTALL[@]}" || return $?

			# packages
			if [[ ${#CARGO_INSTALL[@]} -ne 0 ]]; then
				setup-util --transpose=CARGO -- "${CARGO_INSTALL[@]}" || return $?
			fi
		fi
	}
	function __rust_install {
		# checks
		if __is_brew && [[ -n "$(brew-installed -- rustup rust || :)" ]]; then
			if confirm --linger --positive --ppid=$$ -- 'Confirm moving Rust from the Homebrew to rustup?' 'Rust is currently installed via homebrew.' 'Rustup is the official and only endorsed method of managing Rust.'; then
				brew uninstall -f rustup rust || return $?
			else
				return 125 # ECANCELED 125 Operation cancelled
			fi
		fi

		# https://rust-lang.github.io/rustup/installation/other.html
		# rustup: Unable to run interactively. Run with -y to accept defaults, --help for additional options
		# stdout to /dev/null as it useless stuff goes to stdout, useful stuff goes to stderr
		fetch 'https://sh.rustup.rs' | sh -s -- --quiet --no-modify-path -y >/dev/null || return $?
	}
	function __rust_upgrade {
		rustup update || return $?
	}
	function __rust_uninstall {
		rustup self uninstall || return $?
	}

	# setup
	setup_util "${util_options[@]}" "${setup_options[@]}"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_util_rust "$@"
fi
