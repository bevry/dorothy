#!/usr/bin/env bash

function setup_system_test() (
	source "$DOROTHY/sources/bash.bash"
	eval-tester --ignore-stderr --status=22 -- setup-system --help
)

function setup_system() (
	source "$DOROTHY/sources/bash.bash"
	source "$(type -P eval-helper)"

	# =====================================
	# Arguments

	function help {
		__print_help "$@" <<-EOF || return $?
			ABOUT:
			Configure the system to our expectations.

			USAGE:
			\`setup-system <install|update|clean>\`
		EOF
		return 22 # EINVAL 22 Invalid argument
	}

	# process
	local item action=''
	while [[ $# -ne 0 ]]; do
		item="$1"
		shift
		case "$item" in
		'--help' | '-h') help ;;
		'--'*) help 'An unrecognised flag was provided: ' --variable-value={item} ;;
		*)
			if [[ -z $action ]]; then
				action="$item"
			else
				help 'An unrecognised argument was provided: ' --variable-value={item}
			fi
			;;
		esac
	done

	# assert action
	if [[ -z $action ]]; then
		help --help='An <action> must be provided.'
	fi
	if [[ ! $action =~ ^(install|update|clean)$ ]]; then
		help --help='An unrecognised <action> was provided: ' --variable-value={action}
	fi

	# generate log title
	local action_title
	action_title="$(__get_uppercase_first_letter "$action")"
	action_title+=' System'

	# =====================================
	# Action

	if is-system --mac; then
		# reassert minimal apple dependencies
		setup-util install -- apple-rosetta apple-cli-tools
		setup-util upstall -- brew
	fi

	# upgrade all existing packages
	# ask, because manjaro and rolling releases can demand over 40GB for initial upgrades
	if confirm --linger --positive --ppid=$$ -- 'Upgrade existing packages?'; then
		setup-util upgrade-all --confirm --verbose --sources=apk,apt,dnf,pacman,zypper,... || return $?
	fi

	# setup essential system utilities
	if [[ $action == 'install' ]]; then
		setup-util-devel install
	fi
	if is-system --raspi; then
		setup-linux-raspi "$action" # @todo move to `setup-util-*` ecosystem
	fi
	if [[ $action == 'install' ]] && confirm --linger --negative --ppid=$$ -- 'Enable recovery hotkeys?'; then
		setup-linux-recovery # @todo move to `setup-util-*` ecosystem
	fi

	# install package managers
	if [[ $action == 'install' ]]; then
		if __is_linux; then
			# in this order, based on dependency relationships
			# relevacny is already handled by their scripts
			setup-util install --optional --confirm -- pamac snap flatpak gnome-software
		fi
	fi

	# upgrade the entire system
	setup-util system-upgrade --optional --confirm

	# setup user packages
	# @todo redo this to do `SETUP_UTILS`, etc.
	# for item in "${packages[@]}"; do
	# 	if __command_exists -- "$item"; then
	# 		eval_helper --no-wrap --shapeshifter \
	# 			--pending="$(__print_style --bold="Installing packages of $item...")" \
	# 			--success="$(__print_style --success="Installed packages of $item.")" \
	# 			--failure="$(__print_style --error="Failed to install packages of $item.")" -- \
	# 			"do_${item}_packages"
	# 	fi
	# done

	# cleanup
	setup-util clean-all --verbose || return $?


	# log
	__print_style --h1="$action_title"

	# action
	if [[ $action =~ ^(install|update)$ ]]; then
		# pre-requisites
		is-internet-working

		# update dorothy
		if confirm --linger --negative --ppid=$$ -- 'Update Dorothy?'; then
			dorothy update
		fi

		# system
		if __is_macos; then
			setup-mac "$action"
		elif __is_linux; then
			if is-system --raspi; then
				setup-linux-raspi
		fi

		# windows
		if is-system --scoop; then
			scoop update
			scoop update --all
		fi
		if is-system --winget; then
			winget.exe upgrade --all --accept-package-agreements --accept-source-agreements
		fi

		# ecosystem
		# don't `setup-dns`, as it can cause issues on fragile environments
		# let users call it themselves
		setup-git "$action"

		# @todo `setup-utils`
		# if [[ $action == 'install' ]]; then
		# 	setup-util install "${SETUP_UTILS[@]}"
		# else
		# 	setup-util upgrade -- "${SETUP_UTILS[@]}"
		# fi

		# extras
		if [[ $action == 'install' ]]; then
			# shell
			setup-shell
		fi
	fi

	# clean
	function clean_dirs {
		local caches recreate
		caches=(
			"$HOME/Library/Application Support/Plex Media Server/Updates"
			"$HOME/Library/Application Support/Spotify/PersistentCache/Update"
			"$XDG_CACHE_HOME"
		)
		recreate=(
			"$XDG_CACHE_HOME"
			# "$XDG_CACHE_HOME/gems"
			# "$XDG_CACHE_HOME/pip/http"
		)
		fs-remove --quiet --no-confirm --elevate -- "${caches[@]}" || :
		__mkdirp "${recreate[@]}"
	}
	eval_helper --quiet --wrap --shapeshifter \
		--pending="$(__print_style --bold="Cleaning directory caches...")" \
		--success="$(__print_style --success="Cleaned directory caches.")" \
		--failure="$(__print_style --error="Failed to clean directory caches.")" -- \
		clean_dirs

	# npm
	if setup-util-npm is-installed; then
		eval_helper --quiet --wrap --shapeshifter \
			--pending="$(__print_style --bold="Cleaning npm...")" \
			--success="$(__print_style --success="Cleaned npm.")" \
			--failure="$(__print_style --error="Failed to clean npm.")" -- \
			node-env -- npm cache clean --force || :
	fi

	# operating system
	if __is_macos; then
		setup-mac clean
	elif __is_linux; then
		setup-linux clean
	fi

	# log
	__print_style --g1="$action_title"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	if [[ $* == '--test' ]]; then
		setup_system_test
	else
		setup_system "$@"
	fi
fi
