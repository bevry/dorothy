#!/usr/bin/env bash

# https://github.com/showcases/fonts
# https://github.com/todylu/monaco.ttf

function setup_util_monaco() (
	source "$DOROTHY/sources/util.bash"
	util_options=(
		--font='Monaco.ttf'
	)

	# skip costly operations and fetches on shallow actions
	if setup-util is-shallow "${util_options[@]}" "${setup_options[@]}"; then
		setup-util shallow "${util_options[@]}" "${setup_options[@]}" || return $?
		return $?
	fi

	# fetch and use configuration
	__fetch_and_add_download_option_via_slug_pathname_filename 'todylu/monaco.ttf' 'monaco.ttf' 'Monaco.ttf' || :

	# setup
	setup-util "${util_options[@]}" "${setup_options[@]}"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_util_monaco "$@"
fi
