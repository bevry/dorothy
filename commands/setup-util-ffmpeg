#!/usr/bin/env bash

# https://github.com/homebrew-ffmpeg/homebrew-ffmpeg

# before this use to be a lot more complicated, but now it seems all bugs are resolved
#
# about dependencies <https://trac.ffmpeg.org/wiki/CompilationGuide/macOS>
# about options: <https://trac.ffmpeg.org/wiki/CompilationGuide/macOS#Additionaloptions>

# dependencies are now included within the ffmpeg tap, so no need to tap them separately, and no need to uninstall them and reinstall them to avoid conflicts
# previously code was like so:
#
# `amiaopensource/amiaos/decklinksdk`
# `chromaprint`
# `lescanauxdiscrets/tap/zvbi`
#
# resolved: <https://github.com/varenc/homebrew-ffmpeg/issues/28>
#
# previously, installing `chromaprint` would cause `ffmpeg` (non-tap version) to be installed automatically, as such we need to remove `chromaprint` and `ffmpeg` so the tap'd `ffmpeg` can be installed properly. Examples of issues:
# Uninstall is necessary to prevent:
# ```
# Error: ffmpeg is already installed
# ```
# `--ignore-dependencies` is necessary to prevent:
# ```
#     Error: Refusing to uninstall because it is required by chromaprint, which is currently installed.
#     Error: chromaprint not found
# ```
# resolved: <https://github.com/homebrew-ffmpeg/homebrew-ffmpeg/issues/13#issuecomment-647408007>

function setup_util_ffmpeg() (
	source "$DOROTHY/sources/bash.bash"
	# @todo support other operating systems besides macos with homebrew
	util_options=(
		--cli='ffmpeg'
		CUSTOM_UPSTALL_EVAL='__ffmpeg_install'
		CUSTOM_UNINSTALL_EVAL='__ffmpeg_uninstall'
	)
	function __ffmpeg_install {
		# checks
		if __is_brew; then
			# fetch all possible build options for ffmpeg
			local options_for_ffmpeg=()
			__split --target={options_for_ffmpeg} --delimiter=' ' --no-zero-length --invoke -- \
				brew options homebrew-ffmpeg/ffmpeg/ffmpeg --compact || return $?

			# remove unwanted options that break the build
			local HOMEBREW_ENCODING_REMOVE_OPTIONS=(
				# `--with-decklink` resolved: <https://github.com/homebrew-ffmpeg/homebrew-ffmpeg/issues/81#issuecomment-828722622>
				# `--with-librsvg` resolved: <https://github.com/homebrew-ffmpeg/homebrew-ffmpeg/issues/96#issuecomment-1398315717>
				# `--with-decklink` resolved: <https://github.com/homebrew-ffmpeg/homebrew-ffmpeg/issues/92>
				# `--with-game-music-emu` resolved: <https://github.com/homebrew-ffmpeg/homebrew-ffmpeg/issues/37#issuecomment-958018136>
				# `--with-libzvbi` resolved: Error: An exception occurred within a child process: FormulaUnavailableError: No available formula with the name "zvbi".
				# `--with-libflite` resolved: ERROR: libflite not found
				# `--enable-openvino --with-openvino` resolved: Unknown option "--enable-openvino".
			)
			if [[ ${#HOMEBREW_ENCODING_REMOVE_OPTIONS[@]} -ne 0 ]]; then
				__evict --source+target={options_string_for_ffmpeg} --optional --every -- \
					"${HOMEBREW_ENCODING_REMOVE_OPTIONS[@]}" || return $?
			fi

			# install with the build options
			brew trust homebrew-ffmpeg/ffmpeg || return $?
			brew tap homebrew-ffmpeg/ffmpeg || return $?
			brew install homebrew-ffmpeg/ffmpeg/ffmpeg "${options_for_ffmpeg[@]}" || return $?
		else
			# @todo support other systems
			return "$STATUS__UTILITY_NOT_FOR_SYSTEM"
		fi
	}
	function __ffmpeg_uninstall {
		setup-util uninstall BREW='homebrew-ffmpeg/ffmpeg/ffmpeg' || return $?
	}

	# setup
	setup_util "${util_options[@]}" "${setup_options[@]}"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_util_ffmpeg "$@"
fi
