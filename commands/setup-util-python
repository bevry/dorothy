#!/usr/bin/env bash

function setup_util_python() (
	source "$DOROTHY/sources/bash.bash"
	util_options=(
		--name='Python'
		# --dependency='uv --optional'
		--sources='uv | ...'
		APK='python3'
		APT='python3'
		AUR='python3'
		BREW='python3'
		RPM='python3'
		UV='python'
		ZYPPER='python3'
	)
	setup-util "${util_options[@]}" "${setup_options[@]}"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_util_python "$@"
fi
