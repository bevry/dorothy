#!/usr/bin/env bash

function get_installer() (
	source "$DOROTHY/sources/bash.bash"
	dorothy-warnings crash --code='get-installer' --bold=' has been deprecated in favor of ' --code='setup-util get-installer'
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	get_installer "$@"
fi
